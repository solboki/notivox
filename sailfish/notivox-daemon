def choose_voice(lang):
    voices = installed_voices()
    want = CFG.get("voices", {}).get(lang)
    if want in voices:
        return want
    same = sorted(k for k in voices if voice_lang(k) == lang)
    return same[0] if same else None


def piper_env():
    env = dict(os.environ)
    env["LD_LIBRARY_PATH"] = PIPER_DIR + (
        ":" + env["LD_LIBRARY_PATH"] if env.get("LD_LIBRARY_PATH") else "")
    return env


class PiperPool:
    """Garde un processus Piper vivant par voix récemment utilisée : le
    chargement d'un modèle prend une à deux secondes, la synthèse d'une
    phrase ensuite une fraction de seconde."""

    MAX = 2
    IDLE = 300

    def __init__(self):
        self.procs = {}   # voix -> [Popen, dernière utilisation, vitesse]
        self.lock = threading.Lock()

    def _spawn(self, voice, speed):
        model = installed_voices().get(voice)
        if not model:
            raise RuntimeError("voix absente : %s" % voice)
        exe = os.path.join(PIPER_DIR, "piper")
        cmd = [exe, "--model", model, "--json-input", "--quiet",
               "--espeak_data", os.path.join(PIPER_DIR, "espeak-ng-data"),
               "--length_scale", "%.3f" % (1.0 / max(0.4, speed))]
        dbg("lancement de Piper :", voice)
        return subprocess.Popen(cmd, stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True,
                                encoding="utf-8", bufsize=1, env=piper_env())

    def synth(self, voice, text, out_path, speed):
        with self.lock:
            for attempt in (1, 2):
                ent = self.procs.get(voice)
                if ent and (ent[0].poll() is not None or ent[2] != speed):
                    self._kill(voice)
                    ent = None
                if not ent:
                    while len(self.procs) >= self.MAX:
                        oldest = min(self.procs, key=lambda k:
                                     self.procs[k][1])
                        self._kill(oldest)
                    ent = [self._spawn(voice, speed), 0, speed]
                    self.procs[voice] = ent
                ent[1] = time.time()
                p = ent[0]
                try:
                    p.stdin.write(json.dumps({"text": text,
                                              "output_file": out_path},
                                             ensure_ascii=False) + "\n")
                    p.stdin.flush()
                    ready, _, _ = select.select([p.stdout], [], [], 60)
                    if ready:
                        line = p.stdout.readline().strip()
                        if line and os.path.exists(out_path):
                            return out_path
                except (BrokenPipeError, OSError) as exc:
                    dbg("Piper interrompu :", exc)
                self._kill(voice)
            raise RuntimeError("Piper n'a pas produit de son")

    def _kill(self, voice):
        ent = self.procs.pop(voice, None)
        if ent:
            try:
                ent[0].kill()
                ent[0].wait(2)
            except Exception:
                pass

    def cleanup(self, keep=None):
        with self.lock:
            now = time.time()
            for v in [k for k, e in self.procs.items()
                      if now - e[1] > self.IDLE and k != keep]:
                dbg("arrêt de Piper inactif :", v)
                self._kill(v)

    def stop(self):
        with self.lock:
            for v in list(self.procs):
                self._kill(v)


def espeak_synth(lang, text, out_path, speed):
    exe = os.path.join(PIPER_DIR, "espeak-ng")
    cmd = [exe, "--path=" + PIPER_DIR, "-v", lang,
           "-s", str(int(165 * speed)), "-w", out_path, text]
    subprocess.run(cmd, env=piper_env(), timeout=30,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not os.path.exists(out_path) or os.path.getsize(out_path) < 100:
        raise RuntimeError("eSpeak NG n'a pas produit de son")
    return out_path


def apply_volume(path, percent):
    """Ajuste le volume du fichier WAV (16 bits) en place."""
    if percent == 100:
        return
    with wave.open(path, "rb") as w:
        params = w.getparams()
        data = w.readframes(w.getnframes())
    if params.sampwidth != 2:
        return
    a = array("h")
    a.frombytes(data)
    if sys.byteorder == "big":
        a.byteswap()
    g = max(0.1, min(1.5, percent / 100.0))
    for i in range(len(a)):
        v = int(a[i] * g)
        a[i] = 32767 if v > 32767 else (-32768 if v < -32768 else v)
    if sys.byteorder == "big":
        a.byteswap()
    with wave.open(path, "wb") as w:
        w.setparams(params)
        w.writeframes(a.tobytes())


def parse_props(s):
    out = []
    for part in (s or "").split(";"):
        if "=" in part:
            k, v = part.split("=", 1)
            if k.strip():
                out.append((k.strip(), v.strip()))
    return out


def player_command(path, props, device=None):
    if os.environ.get("NOTIVOX_PLAYER"):
        return [os.environ["NOTIVOX_PLAYER"], path] + \
            (["--device=" + device] if device else [])
    dev = ["--device=" + device] if device else []
    if shutil.which("paplay"):
        return ["paplay"] + dev + \
            ["--property=%s=%s" % kv for kv in props] + [path]
    if find_libpulse_simple():
        return [sys.executable, os.path.abspath(__file__), "--play", path] + \
            dev + ["%s=%s" % kv for kv in props]
    if shutil.which("gst-launch-1.0"):
        sp = ",".join("%s=%s" % kv for kv in props)
        sink = ["pulsesink"] + (["device=" + device] if device else []) + \
            (['stream-properties=props,' + sp] if sp else [])
        return ["gst-launch-1.0", "-q", "filesrc", "location=" + path, "!",
                "wavparse", "!", "audioconvert", "!", "audioresample",
                "!"] + sink
    if shutil.which("aplay"):
        return ["aplay", "-q", path]
    return None


def find_libpulse_simple():
    for name in ("libpulse-simple.so.0", "/usr/lib64/libpulse-simple.so.0",
                 "/usr/lib/libpulse-simple.so.0"):
        if os.path.sep not in name or os.path.exists(name):
            try:
                import ctypes
                return ctypes.CDLL(name)
            except OSError:
                continue
    return None


def play_with_libpulse(path, props, device=None):
    """Lecteur de secours, quand paplay n'est pas installé : joue le
    fichier WAV avec la bibliothèque PulseAudio présente sur tout
    téléphone Sailfish. Lancé dans un processus à part pour pouvoir être
    interrompu."""
    import ctypes
    lib = find_libpulse_simple()
    if not lib:
        return 1
    props = dict(props)
    # media.name devient le nom du flux ; les autres propriétés passent
    # par la variable PULSE_PROP, lue par la bibliothèque au démarrage.
    stream_name = props.pop("media.name", "Notivox")
    if props:
        os.environ["PULSE_PROP"] = " ".join(
            "%s='%s'" % (k, v.replace("'", "")) for k, v in props.items())

    class Spec(ctypes.Structure):
        _fields_ = [("format", ctypes.c_int), ("rate", ctypes.c_uint32),
                    ("channels", ctypes.c_uint8)]

    with wave.open(path, "rb") as w:
        if w.getsampwidth() != 2:
            return 1
        spec = Spec(3, w.getframerate(), w.getnchannels())  # S16LE
        data = w.readframes(w.getnframes())
    lib.pa_simple_new.restype = ctypes.c_void_p
    lib.pa_simple_new.argtypes = [ctypes.c_char_p, ctypes.c_char_p,
                                  ctypes.c_int, ctypes.c_char_p,
                                  ctypes.c_char_p, ctypes.POINTER(Spec),
                                  ctypes.c_void_p, ctypes.c_void_p,
                                  ctypes.POINTER(ctypes.c_int)]
    lib.pa_simple_write.argtypes = [ctypes.c_void_p, ctypes.c_char_p,
                                    ctypes.c_size_t,
                                    ctypes.POINTER(ctypes.c_int)]
    lib.pa_simple_drain.argtypes = [ctypes.c_void_p,
                                    ctypes.POINTER(ctypes.c_int)]
    lib.pa_simple_free.argtypes = [ctypes.c_void_p]
    err = ctypes.c_int(0)
    s = lib.pa_simple_new(None, b"Notivox", 1,
                          device.encode("utf-8") if device else None,
                          stream_name.encode("utf-8"), ctypes.byref(spec),
                          None, None, ctypes.byref(err))
    if not s:
        print("pa_simple_new: erreur %d" % err.value, file=sys.stderr)
        return 1
    try:
        lib.pa_simple_write(s, data, len(data), ctypes.byref(err))
        lib.pa_simple_drain(s, ctypes.byref(err))
    finally:
        lib.pa_simple_free(s)
    return 0


