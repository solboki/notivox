def _sig_split(sig):
    """Découpe une signature D-Bus en types complets."""
    out, i = [], 0
    while i < len(sig):
        j = i
        while sig[j] == "a":
            j += 1
        if sig[j] in "({":
            depth = 0
            while True:
                if sig[j] in "({":
                    depth += 1
                elif sig[j] in ")}":
                    depth -= 1
                    if depth == 0:
                        break
                j += 1
        out.append(sig[i:j + 1])
        i = j + 1
    return out


_ALIGN = {"y": 1, "b": 4, "n": 2, "q": 2, "i": 4, "u": 4, "x": 8, "t": 8,
          "d": 8, "s": 4, "o": 4, "g": 1, "v": 1, "a": 4, "(": 8, "{": 8,
          "h": 4}
_FMT = {"y": "B", "b": "I", "n": "h", "q": "H", "i": "i", "u": "I",
        "x": "q", "t": "Q", "d": "d", "h": "I"}


def _pad(buf, n):
    buf.extend(b"\0" * (-len(buf) % n))


def _write(buf, t, v):
    c = t[0]
    _pad(buf, _ALIGN[c])
    if c in _FMT:
        buf.extend(struct.pack("<" + _FMT[c], int(v) if c != "d" else v))
    elif c in "so":
        b = v.encode("utf-8")
        buf.extend(struct.pack("<I", len(b)) + b + b"\0")
    elif c == "g":
        b = v.encode("ascii")
        buf.extend(struct.pack("<B", len(b)) + b + b"\0")
    elif c == "v":
        _write(buf, "g", v[0])
        _write(buf, v[0], v[1])
    elif c == "a":
        elem = t[1:]
        at = len(buf)
        buf.extend(b"\0\0\0\0")
        _pad(buf, _ALIGN[elem[0]])
        start = len(buf)
        items = v.items() if elem[0] == "{" else v
        for item in items:
            _write(buf, elem, item)
        struct.pack_into("<I", buf, at, len(buf) - start)
    elif c in "({":
        for sub, x in zip(_sig_split(t[1:-1]), v):
            _write(buf, sub, x)


def _read(data, pos, t):
    c = t[0]
    pos += -pos % _ALIGN[c]
    if c in _FMT:
        size = struct.calcsize("<" + _FMT[c])
        v = struct.unpack_from("<" + _FMT[c], data, pos)[0]
        return (bool(v) if c == "b" else v), pos + size
    if c in "so":
        n = struct.unpack_from("<I", data, pos)[0]
        return data[pos + 4:pos + 4 + n].decode("utf-8", "replace"), \
            pos + 5 + n
    if c == "g":
        n = data[pos]
        return data[pos + 1:pos + 1 + n].decode("ascii"), pos + 2 + n
    if c == "v":
        sig, pos = _read(data, pos, "g")
        return _read(data, pos, sig)
    if c == "a":
        n = struct.unpack_from("<I", data, pos)[0]
        pos += 4
        elem = t[1:]
        pos += -pos % _ALIGN[elem[0]]
        end, out = pos + n, []
        while pos < end:
            v, pos = _read(data, pos, elem)
            out.append(v)
        return (dict(out) if elem[0] == "{" else out), pos
    if c in "({":
        out = []
        for sub in _sig_split(t[1:-1]):
            v, pos = _read(data, pos, sub)
            out.append(v)
        return tuple(out), pos
    raise ValueError("type D-Bus non pris en charge : %s" % t)


class MiniBus:
    """Connexion minimale au bus de session : envoi et réception de
    messages, sans bibliothèque."""

    def __init__(self, address=None):
        address = address or os.environ.get("DBUS_SESSION_BUS_ADDRESS") or \
            "unix:path=/run/user/%d/dbus/user_bus_socket" % os.getuid()
        path = abstract = None
        for part in address.split(";")[0].split(":", 1)[1].split(","):
            k, _, v = part.partition("=")
            if k == "path":
                path = v
            elif k == "abstract":
                abstract = v
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path if path else "\0" + abstract)
        uid = str(os.getuid()).encode().hex().encode()
        self.sock.sendall(b"\0AUTH EXTERNAL " + uid + b"\r\n")
        if not self._line().startswith(b"OK"):
            raise RuntimeError("authentification D-Bus refusée")
        self.sock.sendall(b"BEGIN\r\n")
        self.serial = 0
        self.buf = b""
        self.lock = threading.Lock()
        self.pending = {}
        self.hello = self.call("org.freedesktop.DBus",
                               "/org/freedesktop/DBus",
                               "org.freedesktop.DBus", "Hello", "", [],
                               wait=True)
        self.unique = ""

    def _line(self):
        out = b""
        while not out.endswith(b"\r\n"):
            ch = self.sock.recv(1)
            if not ch:
                break
            out += ch
        return out

    def send(self, mtype, fields, sig="", args=(), flags=0):
        body = bytearray()
        for t, v in zip(_sig_split(sig), args):
            _write(body, t, v)
        with self.lock:
            self.serial += 1
            serial = self.serial
            f = list(fields)
            if sig:
                f.append((8, ("g", sig)))
            head = bytearray(b"l" + bytes([mtype, flags, 1]))
            head.extend(struct.pack("<II", len(body), serial))
            _write(head, "a(yv)", f)
            _pad(head, 8)
            self.sock.sendall(bytes(head) + bytes(body))
        return serial

    def call(self, dest, path, iface, member, sig="", args=(), wait=False):
        return self.send(1, [(1, ("o", path)), (2, ("s", iface)),
                             (3, ("s", member)), (6, ("s", dest))],
                         sig, args, flags=0 if wait else 1)

    def reply(self, msg, sig="", args=()):
        f = [(5, ("u", msg["serial"]))]
        if msg.get(7):
            f.append((6, ("s", msg[7])))
        self.send(2, f, sig, args)

    def error(self, msg, name, text):
        f = [(5, ("u", msg["serial"])), (4, ("s", name))]
        if msg.get(7):
            f.append((6, ("s", msg[7])))
        self.send(3, f, "s", [text])

    def signal(self, path, iface, member, sig="", args=()):
        self.send(4, [(1, ("o", path)), (2, ("s", iface)),
                      (3, ("s", member))], sig, args)

    def receive(self):
        """Message suivant (dict : type, serial, champs d'en-tête par
        numéro, args), ou None si la connexion est fermée."""
        while True:
            if len(self.buf) >= 16:
                blen, serial, flen = struct.unpack_from("<III", self.buf, 4)
                hlen = 16 + flen + (-(16 + flen) % 8)
                if len(self.buf) >= hlen + blen:
                    data = self.buf[:hlen + blen]
                    self.buf = self.buf[hlen + blen:]
                    if data[0:1] != b"l":
                        continue
                    fields, _ = _read(data, 12, "a(yv)")
                    msg = {k: v for k, v in fields}
                    msg["type"], msg["serial"] = data[1], serial
                    args, pos = [], hlen
                    try:
                        for t in _sig_split(msg.get(8, "")):
                            v, pos = _read(data, pos, t)
                            args.append(v)
                    except Exception:
                        args = []
                    msg["args"] = args
                    return msg
            chunk = self.sock.recv(65536)
            if not chunk:
                return None
            self.buf += chunk


class MprisButton(threading.Thread):
    """Lecteur multimédia fictif, présent seulement pendant une lecture."""

    def __init__(self, on_stop, on_next):
        super().__init__(daemon=True)
        self.on_stop, self.on_next = on_stop, on_next
        self.bus = None
        self.owned = False
        self.want = False
        self.states = {}
        self.paused = []
        self.muted = []
        self.ignore_until = 0.0
        self.lock = threading.Lock()

    def run(self):
        while True:
            try:
                self.bus = MiniBus()
                self.owned = False
                self.loop()
            except Exception as exc:
                dbg("bouton du casque indisponible :", exc)
            self.bus = None
            time.sleep(10)


    @property
    def unique(self):
        return self.bus.unique if self.bus else ""

    def loop(self):
        while True:
            msg = self.bus.receive()
            if msg is None:
                return
            if msg["type"] == 2 and msg.get(5) == self.bus.hello and \
                    msg["args"]:
                self.bus.unique = msg["args"][0]
            if msg["type"] == 1:
                try:
                    self.handle(msg)
                except Exception as exc:
                    dbg("MPRIS : %s" % exc)

    def set_active(self, on):
        """Début (on) ou fin d'une lecture de Notivox.

        Au début, les lecteurs qui jouaient sont mis en pause ; à la fin,
        ils reprennent. Notivox se déclare aussi lecteur multimédia, ce qui
        l'affiche dans les commandes de l'écran de verrouillage."""
        with self.lock:
            self.want = on
            if on == self.owned:
                return
            self.owned = on
            bus = self.bus
            if bus is not None:
                try:
                    bus.call("org.freedesktop.DBus", "/org/freedesktop/DBus",
                             "org.freedesktop.DBus",
                             "RequestName" if on else "ReleaseName",
                             "su" if on else "s",
                             [MPRIS_NAME, 4] if on else [MPRIS_NAME],
                             wait=True)
                except Exception as exc:
                    dbg("MPRIS : %s" % exc)
            dbg("lecture de Notivox %s" % ("commencée" if on else "finie"))
        if on:
            self.begin()
        else:
            self.resume_others()

    def player_states(self):
        """{nom du lecteur: (nom unique sur le bus, état)}."""
        out = {}
        names = dbus_send("session", "org.freedesktop.DBus", "/",
                          "org.freedesktop.DBus.ListNames") or [[]]
        for name in names[0] if names and isinstance(names[0], list) else []:
            if not str(name).startswith("org.mpris.MediaPlayer2.") or \
                    name == MPRIS_NAME:
                continue
            owner = dbus_send("session", "org.freedesktop.DBus", "/",
                              "org.freedesktop.DBus.GetNameOwner",
                              "string:" + name)
            st = player_status(name)
            if owner:
                out[name] = (owner[0], st)
        return out

    def begin(self):
        """Met en pause les lecteurs qui jouent, avant que Notivox parle.
        Les flux audio qui ne sont pas des lecteurs pilotables (certaines
        applications Android) sont rendus muets à la place."""
        if not CFG.get("pause_players", True):
            self.states = {}
            return
        players = self.player_states()
        self.states = {}
        for name, (unique, st) in players.items():
            self.states[name] = self.states[unique] = st
        playing = [n for n, (_u, st) in players.items() if st == "Playing"]
        self.paused = playing
        for name in playing:
            self.ignore_until = time.time() + 1.5
            dbus_send("session", name, MPRIS_PATH,
                      "org.mpris.MediaPlayer2.Player.Pause")
            log("lecteur mis en pause pendant la lecture :", name)
        # Les flux audio ne sont rendus muets que si aucun lecteur pilotable
        # ne jouait : sinon, la pause suffit, et l'on risquerait de couper
        # le son d'une autre application.
        self.muted = [] if playing else mute_media_streams()
        dbg("lecteurs au début de la lecture :", players)

    def resume_others(self, skip=()):
        """Relance les lecteurs que Notivox avait mis en pause, et rend le
        son aux flux rendus muets."""
        paused, self.paused = self.paused, []
        muted, self.muted = self.muted, []
        unmute_streams(muted)
        for name in paused:
            if name in skip or player_status(name) == "Playing":
                continue
            self.ignore_until = time.time() + 1.5
            dbus_send("session", name, MPRIS_PATH,
                      "org.mpris.MediaPlayer2.Player.Play")
            log("lecture reprise :", name)

    def props(self, iface):
        if iface == "org.mpris.MediaPlayer2":
            return {"CanQuit": ("b", False), "CanRaise": ("b", False),
                    "HasTrackList": ("b", False),
                    "Identity": ("s", "Notivox"),
                    "DesktopEntry": ("s", ""),
                    "SupportedUriSchemes": ("as", []),
                    "SupportedMimeTypes": ("as", [])}
        return {"PlaybackStatus": ("s", "Playing" if self.owned
                                   else "Stopped"),
                "Rate": ("d", 1.0), "Volume": ("d", 1.0),
                "Position": ("x", 0), "MinimumRate": ("d", 1.0),
                "MaximumRate": ("d", 1.0),
                "Metadata": ("a{sv}", {
                    "mpris:trackid": ("o", "/org/notivox/lecture"),
                    "xesam:title": ("s", "Notivox"),
                    "xesam:artist": ("as", ["Notivox"])}),
                "CanGoNext": ("b", True), "CanGoPrevious": ("b", False),
                "CanPlay": ("b", True), "CanPause": ("b", True),
                "CanSeek": ("b", False), "CanControl": ("b", True)}

    def handle(self, msg):
        iface, member = msg.get(2, ""), msg.get(3, "")
        args = msg["args"]
        if member == "Introspect":
            self.bus.reply(msg, "s", [MPRIS_XML])
        elif iface == "org.freedesktop.DBus.Peer" or member == "Ping":
            self.bus.reply(msg)
        elif member == "GetAll":
            self.bus.reply(msg, "a{sv}", [self.props(args[0] if args
                                                     else "")])
        elif member == "Get" and len(args) >= 2:
            p = self.props(args[0]).get(args[1])
            if p is None:
                self.bus.error(msg, "org.freedesktop.DBus.Error."
                               "UnknownProperty", args[1])
            else:
                self.bus.reply(msg, "v", [p])
        elif iface == "org.mpris.MediaPlayer2.Player" and \
                member in ("PlayPause", "Pause", "Stop", "Play"):
            self.bus.reply(msg)
            log("bouton du casque : lecture interrompue")
            self.on_stop()
        elif iface == "org.mpris.MediaPlayer2.Player" and member == "Next":
            self.bus.reply(msg)
            dbg("bouton du casque : notification suivante")
            self.on_next()
        else:
            self.bus.reply(msg)


