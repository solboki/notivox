def calendar_db_path():
    """Base de l'agenda de Sailfish (mkcal), lue directement si possible,
    sinon par une copie de l'assistant (elle est réservée au groupe
    « privileged »)."""
    if CALENDAR_DB:
        return CALENDAR_DB
    plain = os.path.join(HOME, ".local/share/system/Calendar/mkcal/db")
    if os.access(plain, os.R_OK):
        return plain
    if os.path.exists(HELPER):
        try:
            subprocess.run([HELPER, "calendar"], timeout=5,
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        except Exception as exc:
            dbg("copie de l'agenda impossible :", exc)
    path = os.path.join(CACHE_DIR, "calendar.db")
    return path if os.path.exists(path) else None


def _local_dt(secs, secs_local, tz):
    """Heure locale d'une date de mkcal. Une date « flottante » (journée
    entière, ou heure sans fuseau) est stockée comme heure locale ; les
    autres en temps universel."""
    import datetime
    if not tz or tz == "FloatingDate":
        return datetime.datetime.utcfromtimestamp(secs_local or 0)
    return datetime.datetime.fromtimestamp(secs or 0)


def _ints(text):
    out = []
    for x in (text or "").split():
        try:
            out.append(int(x))
        except ValueError:
            pass
    return out


def _month_pos(day, last_day):
    """Rang de ce jour de semaine dans le mois : (1..5, -1..-5)."""
    return (day.day - 1) // 7 + 1, -((last_day - day.day) // 7 + 1)


def rule_matches(rule, start, day):
    """Ce jour est-il une occurrence de la règle de répétition (RRULE),
    sans tenir compte du nombre maximal d'occurrences ?

    Règles prises en charge : quotidienne, hebdomadaire (jours choisis),
    mensuelle (jour du mois, ou « 2e mardi », « dernier vendredi »),
    annuelle ; intervalle et date de fin. C'est ce que propose
    l'application Agenda de Sailfish ; les règles plus rares importées
    d'ailleurs peuvent être mal comprises."""
    import calendar
    import datetime
    d0 = start.date()
    if day < d0:
        return False
    if rule["until"] and day > rule["until"]:
        return False
    freq, interval = rule["freq"], max(1, rule["interval"] or 1)
    bydays = list(zip(_ints(rule["byday"]), _ints(rule["bydaypos"]) or
                      [0] * len(_ints(rule["byday"]))))
    wd = day.isoweekday()   # 1 = lundi, comme dans mkcal
    last = calendar.monthrange(day.year, day.month)[1]

    def day_rule_ok(default_day):
        mdays = _ints(rule["bymonthday"])
        if mdays:
            return any(day.day == (m if m > 0 else last + 1 + m)
                       for m in mdays)
        if bydays:
            pos, neg = _month_pos(day, last)
            return any(w == wd and (p == 0 or p == pos or p == neg)
                       for w, p in bydays)
        return day.day == default_day

    if freq == 4:      # quotidienne
        return (day - d0).days % interval == 0
    if freq == 5:      # hebdomadaire
        monday0 = d0 - datetime.timedelta(days=d0.weekday())
        monday = day - datetime.timedelta(days=day.weekday())
        if ((monday - monday0).days // 7) % interval:
            return False
        days = [w for w, _p in bydays] or [d0.isoweekday()]
        return wd in days
    if freq == 6:      # mensuelle
        months = (day.year - d0.year) * 12 + day.month - d0.month
        return months % interval == 0 and day_rule_ok(d0.day)
    if freq == 7:      # annuelle
        if (day.year - d0.year) % interval:
            return False
        if day.month not in (_ints(rule["bymonth"]) or [d0.month]):
            return False
        return day_rule_ok(d0.day)
    return False


def occurs_on(rule, start, day):
    if not rule_matches(rule, start, day):
        return False
    count = rule["count"]
    if count and count > 0:
        # Nombre limité d'occurrences : on compte celles qui précèdent.
        import datetime
        n, d = 0, start.date()
        while d < day:
            if rule_matches(rule, start, d):
                n += 1
                if n >= count:
                    return False
            d += datetime.timedelta(days=1)
    return True


def today_agenda(now=None):
    """Rendez-vous restants aujourd'hui : liste de (début ou None pour une
    journée entière, titre), dans l'ordre."""
    import datetime
    import sqlite3
    path = calendar_db_path()
    if not path:
        raise RuntimeError("agenda introuvable")
    now_dt = datetime.datetime.fromtimestamp(now or time.time())
    today = now_dt.date()
    db = sqlite3.connect("file:%s" % path, uri=True, timeout=2)
    try:
        hidden = set()
        try:
            for cid, flags in db.execute("SELECT CalendarId, Flags "
                                         "FROM Calendars"):
                if flags is not None and not int(flags) & 128:
                    hidden.add(cid)
        except sqlite3.Error:
            pass
        rules = {}
        for row in db.execute(
                "SELECT ComponentId, Frequency, Until, UntilLocal, "
                "untilTimeZone, Count, Interval, ByDay, ByDayPos, "
                "ByMonthDay, ByMonth FROM Recursive WHERE RuleType = 1"):
            until = None
            if row[2] or row[3]:
                until = _local_dt(row[2], row[3], row[4]).date()
            rules.setdefault(row[0], []).append({
                "freq": row[1], "until": until, "count": row[5],
                "interval": row[6], "byday": row[7], "bydaypos": row[8],
                "bymonthday": row[9], "bymonth": row[10]})
        extra, excluded = {}, {}
        for cid, typ, secs, local, tz in db.execute(
                "SELECT ComponentId, Type, Date, DateLocal, TimeZone "
                "FROM Rdates"):
            d = _local_dt(secs, local, tz)
            (excluded if typ in (2, 4) else extra).setdefault(
                cid, set()).add(d.date())
        comps = db.execute(
            "SELECT ComponentId, Notebook, Summary, DateStart, "
            "DateStartLocal, StartTimeZone, UID, RecurId, RecurIdLocal, "
            "RecurIdTimeZone FROM Components WHERE Type = 'Event' "
            "AND (DateDeleted IS NULL OR DateDeleted = 0)").fetchall()
    finally:
        db.close()
    # Occurrences modifiées : elles remplacent celle de l'événement parent.
    moved = set()
    for c in comps:
        if c[7] or c[8]:
            moved.add((c[6], _local_dt(c[7], c[8], c[9]).date()))
    out = []
    for cid, notebook, title, ds, dsl, tz, uid, rid, ridl, ridtz in comps:
        if notebook in hidden or not (title or "").strip():
            continue
        start = _local_dt(ds, dsl, tz)
        allday = tz == "FloatingDate"
        on_day = start.date() == today
        if not on_day and cid in rules and not (rid or ridl):
            if (uid, today) not in moved and \
                    today not in excluded.get(cid, ()):
                on_day = any(occurs_on(r, start, today)
                             for r in rules[cid])
        if not on_day and today in extra.get(cid, ()):
            on_day = True
        if not on_day:
            continue
        at = datetime.datetime.combine(today, start.time())
        if not allday and at < now_dt:
            continue
        out.append((None if allday else at, clean(title)))
    out.sort(key=lambda x: (x[0] is not None, x[0] or now_dt))
    return out


def agenda_phrase(lang, now=None):
    try:
        items = today_agenda(now)
    except Exception as exc:
        log("agenda illisible :", exc)
        return ""
    if not items:
        return sp("agenda_none", lang)
    parts = [sp("agenda", lang)]
    for at, title in items:
        if at is None:
            parts.append(sp("agenda_allday", lang).format(title=title))
            continue
        h12 = at.hour % 12 or 12
        ampm = "AM" if at.hour < 12 else "PM"
        key = "agenda_at0" if at.minute == 0 else "agenda_at"
        parts.append(sp(key, lang).format(h=at.hour, m=at.minute, h12=h12,
                                          ampm=ampm, title=title))
    return " ".join(parts)


SUMMARY_MODES = ("ignore", "count", "titles", "full")


def summary_mode(app, category=""):
    return app_setting(app, category)["summary"]


def sp(key, lang):
    return phrase("s_" + key, lang)


def join_names(names, lang):
    if len(names) <= 1:
        return "".join(names)
    return "%s %s %s" % (", ".join(names[:-1]), sp("and", lang), names[-1])


def de_app(app, lang):
    """« de Facebook », « d'E-mail » : élision française devant une
    voyelle."""
    if lang == "fr" and app[:1].lower() in "aeéèêiîoôuyh":
        return "d'", app
    return "de ", app


def date_phrase(lang, now=None):
    t = time.localtime(now or time.time())
    wd = sp("weekdays", lang).split()[t.tm_wday]
    mo = sp("months", lang).split()[t.tm_mon - 1]
    day = t.tm_mday
    if lang == "fr" and day == 1:
        day = "1er"
    date = sp("date", lang).format(weekday=wd, day=day, month=mo)
    h12 = t.tm_hour % 12 or 12
    ampm = "AM" if t.tm_hour < 12 else "PM"
    key = "time0" if t.tm_min == 0 else "time"
    hour = sp(key, lang).format(h=t.tm_hour, m=t.tm_min, h12=h12, ampm=ampm)
    return "%s %s" % (date, hour)


def build_summary(events, lang, now=None):
    """Prépare le résumé, sous forme d'une liste d'éléments :
      ("say", texte, langue, ids effaçables après lecture)
      ("pause",) courte pause ; ("sep",) bip (ou pause) autour et entre les
      notifications lues.

    Forme : salutation, et en option date, heure et météo ; nombre total
    de notifications ; pour chaque application, son nombre de
    notifications, puis selon son réglage leurs titres ou leur contenu,
    encadrés de bips ; formule de fin."""
    sc = CFG.get("summary", {})
    groups = {}
    for e in events:
        mode = summary_mode(e["app"], e["category"])
        if mode == "ignore":
            continue
        groups.setdefault(e["app"], {"mode": mode, "items": []})
        groups[e["app"]]["items"].append(e)
    # Applications les plus récemment actives d'abord, comme dans la Vue
    # Événements ; dans chaque application, ordre chronologique.
    order = sorted(groups, key=lambda a: -max(e["id"] for e in
                                              groups[a]["items"]))
    t = time.localtime(now or time.time())
    intro = [sp("evening" if t.tm_hour >= 18 else "hello", lang)]
    if sc.get("date_time", True):
        intro.append(date_phrase(lang, now))
    if sc.get("weather"):
        w = weather_phrase(lang)
        if w:
            intro.append(w)
    out = [("say", " ".join(x for x in intro if x), lang, []), ("pause",)]
    if sc.get("agenda"):
        a = agenda_phrase(lang, now)
        if a:
            out += [("say", a, lang, []), ("pause",)]
    total = sum(len(groups[a]["items"]) for a in order)
    if not total:
        out.append(("say", sp("none", lang) + " " +
                    sp("end", lang).split(".")[-2].strip() + ".", lang, []))
        return out
    out.append(("say", sp("total_1" if total == 1 else "total_n", lang)
                .format(n=total), lang, []))
    out.append(("pause",))
    limit = max(1, int(sc.get("max_items", 30) or 30))
    maxc = int(CFG.get("max_chars", 300) or 300)
    told = skipped = 0
    for app in order:
        g = groups[app]["items"]
        mode = groups[app]["mode"]
        de, name = de_app(app, lang)
        out.append(("say", sp("group_1" if len(g) == 1 else "group_n", lang)
                    .format(n=len(g), app=name, de=de.strip())
                    .replace("d' ", "d'"), lang, []))
        if mode == "count":
            out.append(("pause",))
            continue
        out.append(("sep",))
        for e in g:
            if told >= limit:
                skipped += 1
                continue
            if mode == "titles":
                text = title_of(app, e["summary"], e["body"])
            else:
                sender = e["summary"]
                if sender.strip().lower() == app.strip().lower():
                    sender = ""
                text = ". ".join(x for x in (sender, e["body"]) if x) or app
            if len(text) > maxc:
                text = text[:maxc].rsplit(" ", 1)[0] + "…"
            item_lang = lang
            if CFG.get("detect_language", True):
                item_lang = detect_language(e["summary"] + " " + e["body"],
                                            candidate_langs(), lang)
            out.append(("say", text, item_lang,
                        [e["id"]] if e["removable"] else []))
            out.append(("sep",))
            told += 1
    if skipped:
        out.append(("say", sp("more", lang).format(n=skipped), lang, []))
    out.append(("pause",))
    out.append(("say", sp("end", lang), lang, []))
    return out


def sound_file(kind):
    """Fichier WAV d'une courte pause ou d'un bip doux, créé au besoin."""
    path = os.path.join(CACHE_DIR, "%s.wav" % kind)
    if os.path.exists(path):
        return path
    import math
    rate = 22050
    frames = array("h")
    if kind == "pause":
        frames.extend([0] * int(rate * 0.7))
    else:
        n = int(rate * 0.12)
        for i in range(n):
            env = min(1.0, i / 300.0, (n - i) / 600.0)
            frames.append(int(6000 * env * math.sin(2 * math.pi * 880 * i /
                                                     rate)))
        frames.extend([0] * int(rate * 0.25))
        frames = array("h", [0] * int(rate * 0.2)) + frames
    if sys.byteorder == "big":
        frames.byteswap()
    os.makedirs(CACHE_DIR, exist_ok=True)
    with wave.open(path, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(frames.tobytes())
    return path


def close_notifications(ids):
    """Efface des notifications de la Vue Événements. Sailfish permet à
    toute application d'effacer une notification marquée comme effaçable
    par l'utilisateur, ce qui est le cas par défaut."""
    for nid in ids:
        r = dbus_send("session", "org.freedesktop.Notifications",
                      "/org/freedesktop/Notifications",
                      "org.freedesktop.Notifications.CloseNotification",
                      "uint32:%d" % int(nid))
        dbg("notification %d effacée" % nid if r is not None
            else "notification %d : effacement sans réponse" % nid)


def speak_summary(manual=False, force=False):
    """Lit le résumé de la Vue Événements.

    manual : demandé explicitement (commande, bouton) ; il est alors lu
    même sans nouveauté. force : True pour le lire quoi qu'il arrive,
    "speaker" pour accepter le haut-parleur faute d'écouteurs.

    Chaque phrase est fabriquée puis aussitôt mise dans la file de
    lecture : la voix commence à parler pendant que la suite se prépare."""
    lang = CFG.get("language", "fr")
    if force is not True and not may_speak(speaker_ok=force == "speaker"):
        dbg("résumé non lu :", blocked_reason(speaker_ok=force ==
                                              "speaker"))
        return
    try:
        events = read_events()
    except Exception as exc:
        log("résumé impossible :", exc)
        events = []
    parts = build_summary(events, lang)
    if not manual:
        if not any(summary_mode(e["app"], e["category"]) != "ignore"
                   for e in events):
            dbg("résumé automatique : rien à lire")
            return
        shown = sorted(e["id"] for e in events)
        # Même liste lue il y a moins de 30 minutes : on ne la répète pas.
        if _last_auto["ids"] == shown and \
                time.time() - _last_auto["time"] < 1800:
            dbg("résumé automatique : rien de nouveau depuis le dernier")
            return
        _last_auto["ids"], _last_auto["time"] = shown, time.time()
    sc = CFG.get("summary", {})
    clear = sc.get("clear_after", False)
    beep = sc.get("beep", True)
    d = os.path.join(CACHE_DIR, "summary")
    os.makedirs(d, exist_ok=True)
    log("résumé : %d notifications, %d éléments" % (len(events),
                                                     len(parts)))
    SPEAKER.cancel("summary")
    SUMMARY_RUN[0] += 1
    run = SUMMARY_RUN[0]
    SUMMARY_BUSY[0] = True
    try:
        _queue_summary(parts, d, clear, beep, force, run)
    finally:
        if SUMMARY_RUN[0] == run:
            SUMMARY_BUSY[0] = False


def _queue_summary(parts, d, clear, beep, force, run):
    for n, p in enumerate(parts):
        if SUMMARY_RUN[0] != run:
            dbg("résumé abandonné")
            return
        if p[0] in ("pause", "sep"):
            kind = "beep" if p[0] == "sep" and beep else "pause"
            SPEAKER.say(("wav", sound_file(kind), "son", kind), prio=3,
                        tag="summary", force=force)
            continue
        _k, text, plang, pids = p
        try:
            path = os.path.join(d, "%03d.wav" % n)
            wav, voice = SPEAKER.render(text, plang, path=path)
        except Exception as exc:
            log("phrase du résumé non préparée :", exc)
            continue
        done = None
        if clear and pids:
            done = (lambda x=tuple(pids): close_notifications(x))
        # Priorité 3 : après un appel, avant les nouvelles notifications.
        SPEAKER.say(("wav", wav, voice or "espeak", text), lang=plang,
                    prio=3, tag="summary", force=force, done=done)


def headset_watch():
    """Lance le résumé quand des écouteurs deviennent la sortie son.

    On suit les événements du serveur son (pactl subscribe) plutôt que de
    l'interroger en boucle. Les changements dus à un appel (le casque
    Bluetooth est éteint pendant la sonnerie puis rallumé) sont ignorés."""
    state = {"out": audio_output(), "pending": 0.0}

    def check():
        forget_route()
        new = audio_output()
        old, state["out"] = state["out"], new
        if new not in ("bluetooth", "wired") or old in ("bluetooth",
                                                         "wired"):
            return
        if CALLS or time.time() - LAST_CALL_END[0] < 60:
            dbg("écouteurs : changement lié à un appel, pas de résumé")
            return
        if not CFG.get("summary", {}).get("on_headset", False):
            return
        if blocked_reason():
            dbg("résumé à la connexion non lu :", blocked_reason())
            return
        dbg("écouteurs connectés (%s) : résumé" % new)
        speak_summary(manual=False)

    env = dict(os.environ, LC_ALL="C", LANG="C")
    while True:
        if not shutil.which("pactl"):
            time.sleep(5)
            check()
            continue
        try:
            proc = subprocess.Popen(["pactl", "subscribe"], env=env,
                                    stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True)
        except OSError:
            time.sleep(30)
            continue
        for line in proc.stdout:
            if re.search(r"'(new|change|remove)' on (sink|card) ", line):
                # On laisse le casque s'installer avant de regarder.
                if not state["pending"]:
                    state["pending"] = time.time()
                    threading.Timer(3.0, lambda: (state.update(pending=0.0),
                                                  check())).start()
        proc.wait()
        time.sleep(5)


