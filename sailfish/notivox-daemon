        return None
    try:
        subprocess.run([HELPER, "notifications"], timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as exc:
        dbg("copie des notifications impossible :", exc)
        return None
    path = os.path.join(CACHE_DIR, "notifications.db")
    return path if os.path.exists(path) else None


def read_events():
    """Notifications présentes dans la Vue Événements, de la plus ancienne
    à la plus récente : liste de dict (id, app, summary, body, category,
    removable, type).

    Sailfish (lipstick) garde ces notifications dans une base SQLite. Il
    l'écrit avec quelques secondes de retard : une notification arrivée
    juste avant le résumé peut manquer."""
    path = events_db_path()
    if not path:
        raise RuntimeError("base des notifications introuvable")
    import sqlite3
    db = sqlite3.connect("file:%s" % path, uri=True, timeout=2)
    try:
        cols = _columns(db, "notifications")
        if "id" not in cols or "summary" not in cols:
            raise RuntimeError("table des notifications inattendue : %s"
                               % cols)
        hints = {}
        if "hint" in _columns(db, "hints"):
            for nid, hint, value in db.execute(
                    "SELECT id, hint, value FROM hints"):
                hints.setdefault(nid, {})[str(hint)] = value
        names = [c for c in ("app_name", "explicit_app_name",
                             "disambiguated_app_name") if c in cols]
        rows = db.execute("SELECT id, summary, body, %s FROM notifications "
                          "ORDER BY id" % ", ".join(names or ["''"]))
        out = []
        for row in rows:
            nid, summary, body = row[0], row[1] or "", row[2] or ""
            named = dict(zip(names, row[3:]))
            h = hints.get(nid, {})
            if str(h.get("transient", "")).lower() in ("true", "1"):
                continue
            app = (named.get("explicit_app_name") or
                   named.get("disambiguated_app_name") or
                   named.get("app_name") or "").strip()
            summary = clean(str(summary or h.get("x-nemo-preview-summary")
                                or ""))
            body = clean(str(body or h.get("x-nemo-preview-body") or ""))
            if not summary and not body:
                continue
            category = str(h.get("category") or "")
            removable = str(h.get("x-nemo-user-removable", "true")).lower() \
                not in ("false", "0")
            out.append({"id": int(nid), "app": app or "?",
                        "summary": summary, "body": body,
                        "category": category, "removable": removable,
                        "type": notification_type(app, category)})
        return out
    finally:
        db.close()


# Description des codes météo de l'OMM (Open-Meteo), par langue :
# dégagé, peu nuageux, nuageux, couvert, brouillard, bruine, pluie, neige,
# averses, averses de neige, orage.
WEATHER_WORDS = {
    "fr": "ensoleillé|dégagé|peu nuageux|nuageux|couvert|brouillard|bruine|"
          "pluie|neige|averses|averses de neige|orage",
    "en": "sunny|clear|mostly clear|partly cloudy|overcast|fog|drizzle|"
          "rain|snow|showers|snow showers|thunderstorm",
    "de": "sonnig|klar|leicht bewölkt|bewölkt|bedeckt|Nebel|Nieselregen|"
          "Regen|Schnee|Schauer|Schneeschauer|Gewitter",
    "es": "soleado|despejado|poco nuboso|parcialmente nuboso|cubierto|"
          "niebla|llovizna|lluvia|nieve|chubascos|chubascos de nieve|"
          "tormenta",
    "it": "soleggiato|sereno|poco nuvoloso|nuvoloso|coperto|nebbia|"
          "pioviggine|pioggia|neve|rovesci|rovesci di neve|temporale",
}
_weather = {"time": 0.0, "key": None, "text": ""}


def weather_desc(code, is_day, lang):
    words = (WEATHER_WORDS.get(lang) or WEATHER_WORDS["en"]).split("|")
    c = int(code)
    if c == 0:
        i = 0 if is_day else 1
    elif c == 1:
        i = 2
    elif c == 2:
        i = 3
    elif c == 3:
        i = 4
    elif c in (45, 48):
        i = 5
    elif 51 <= c <= 57:
        i = 6
    elif 61 <= c <= 67:
        i = 7
    elif 71 <= c <= 77:
        i = 8
    elif 80 <= c <= 82:
        i = 9
    elif c in (85, 86):
        i = 10
    else:
        i = 11
    return words[i]


def weather_phrase(lang):
    """« Météo : nuageux, 17 degrés. » d'après Open-Meteo, ou "" en cas
    d'échec (pas de réseau, lieu non choisi). Gardé vingt minutes."""
    place = CFG.get("summary", {}).get("place") or {}
    lat, lon = place.get("lat"), place.get("lon")
    if lat is None or lon is None:
        return ""
    key = (round(float(lat), 3), round(float(lon), 3), lang)
    if _weather["key"] == key and time.time() - _weather["time"] < 1200:
        return _weather["text"]
    import urllib.request
    url = ("https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s"
           "&current=temperature_2m,weather_code,is_day" % (lat, lon))
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Notivox"})
        with urllib.request.urlopen(req, timeout=4) as r:
            cur = json.load(r)["current"]
        town = (place.get("name") or "").strip()
        text = sp("weather_at" if town else "weather", lang).format(
            town=town,
            desc=weather_desc(cur["weather_code"], cur.get("is_day", 1),
                              lang),
            t=int(round(float(cur["temperature_2m"]))))
    except Exception as exc:
        dbg("météo indisponible :", exc)
        return ""
    _weather.update(time=time.time(), key=key, text=text)
    return text


