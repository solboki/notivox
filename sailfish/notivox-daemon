def merge(default, value):
    """Complète value avec les clés manquantes de default, récursivement."""
    if isinstance(default, dict) and isinstance(value, dict):
        out = dict(default)
        for k, v in value.items():
            out[k] = merge(default.get(k), v) if k in default else v
        return out
    return default if value is None else value


def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return merge(default, json.load(f))
    except FileNotFoundError:
        return json.loads(json.dumps(default))
    except Exception as exc:
        log("fichier illisible, valeurs par défaut utilisées :", path, exc)
        return json.loads(json.dumps(default))


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


class Watched:
    """Relit un fichier JSON quand sa date de modification change."""

    def __init__(self, path, default):
        self.path, self.default, self.mtime = path, default, None

    def changed(self):
        try:
            m = os.stat(self.path).st_mtime_ns
        except FileNotFoundError:
            m = 0
        if m != self.mtime:
            self.mtime = m
            return True
        return False

    def load(self):
        return read_json(self.path, self.default)


