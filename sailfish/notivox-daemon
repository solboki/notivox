# Lecture de la sortie de dbus-monitor et de dbus-send
# ---------------------------------------------------------------------------

HEADER_RE = re.compile(r"^(method call|method return|signal|error) ")
TOKEN_RE = re.compile(
    r"^\s+(string |object path |signature |u?int(16|32|64) |byte |"
    r"boolean |double |variant|array \[|dict entry\(|struct \{|\]|\)|\}|"
    r"file descriptor|unix fd)")


def split_messages(lines):
    """Regroupe les lignes en messages (en-tête + lignes de valeurs)."""
    msg = None
    for line in lines:
        line = line.rstrip("\n")
        if HEADER_RE.match(line):
            if msg is not None:
                yield msg
            msg = [line]
        elif msg is not None:
            msg.append(line)
    if msg is not None:
        yield msg


def header_fields(header):
    out = {}
    for m in re.finditer(r"(\w+)=([^\s;]+)", header):
        out[m.group(1)] = m.group(2)
    return out


def tokenize(body):
    """Découpe le corps d'un message en jetons (type, valeur).

    Les chaînes sont affichées par dbus-monitor sans échappement : une
    chaîne peut contenir des guillemets et des retours à la ligne. Elle
    se termine donc sur une ligne finissant par un guillemet, suivie d'une
    ligne qui ressemble au début d'une nouvelle valeur."""
    toks = []
    i, n = 0, len(body)
    while i < n:
        line = body[i]
        s = line.strip()
        if not s:
            i += 1
            continue
        m = re.match(r"^(string|object path|signature) \"(.*)$", s)
        if m:
            rest = m.group(2)
            parts = [rest]
            j = i
            while True:
                last = parts[-1]
                nxt = body[j + 1] if j + 1 < n else None
                if last.endswith('"') and (nxt is None or TOKEN_RE.match(nxt)
                                           or not nxt.strip()):
                    break
                if nxt is None:
                    parts[-1] = last + '"'
                    break
                j += 1
                parts.append(body[j])
            text = "\n".join(parts)[:-1]
            toks.append(("str", text))
            i = j + 1
            continue
        if s.startswith("variant"):
            toks.append(("variant", None))
            rest = s[len("variant"):].strip()
            if rest:
                body = body[:i] + ["   " + rest] + body[i + 1:]
                n = len(body)
                continue
            i += 1
            continue
        if s.startswith("array ["):
            toks.append(("[", None))
            if s.endswith("]"):
                toks.append(("]", None))
        elif s.startswith("dict entry("):
            toks.append(("(", None))
        elif s.startswith("struct {"):
            toks.append(("{", None))
        elif s in ("]", ")", "}"):
            toks.append((s, None))
        else:
            m = re.match(r"^(u?int16|u?int32|u?int64|byte|double) (\S+)", s)
            if m:
                try:
                    v = float(m.group(2)) if m.group(1) == "double" \
                        else int(m.group(2), 0)
                except ValueError:
                    v = m.group(2)
                toks.append(("num", v))
            elif s.startswith("boolean "):
                toks.append(("bool", s.split()[1] == "true"))
            else:
                toks.append(("other", s))
        i += 1
    return toks


def parse_values(toks):
    """Transforme les jetons en valeurs Python (listes, dict, tuples)."""
    pos = 0

    def value():
        nonlocal pos
        t, v = toks[pos]
        pos += 1
        if t == "variant":
            return value()
        if t == "[":
            items = []
            while pos < len(toks) and toks[pos][0] != "]":
                items.append(value())
            pos += 1
            if items and all(isinstance(x, tuple) and len(x) == 3
                             and x[0] == "__entry__" for x in items):
                return {x[1]: x[2] for x in items}
            return items
        if t == "(":
            k = value()
            val = value()
            if pos < len(toks) and toks[pos][0] == ")":
                pos += 1
            return ("__entry__", k, val)
        if t == "{":
            items = []
            while pos < len(toks) and toks[pos][0] != "}":
                items.append(value())
            pos += 1
            return tuple(items)
        return v

    out = []
    while pos < len(toks):
        if toks[pos][0] in ("]", ")", "}"):
            pos += 1
            continue
        out.append(value())
    return out


def parse_message(msg):
    head = header_fields(msg[0])
    head["kind"] = msg[0].split(" time=")[0]
    return head, parse_values(tokenize(msg[1:]))


def monitor(bus, matches, handler, name):
    """Lance dbus-monitor et transmet chaque message à handler, en boucle
    (avec redémarrage si dbus-monitor s'arrête)."""
    cmd = ["dbus-monitor", "--" + bus] + matches
    while True:
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, bufsize=0)
        except OSError as exc:
            log("impossible de lancer dbus-monitor (%s) : %s" % (name, exc))
            time.sleep(30)
            continue
        dbg("écoute", name, "lancée")
        buf = []

        def flush():
            for m in split_messages(buf):
                try:
                    handler(*parse_message(m))
                except Exception as exc:
                    log("erreur de traitement (%s) : %r" % (name, exc))
            buf.clear()

        # Lecture directe du descripteur : un readline() tamponné cacherait
        # à select() des lignes déjà reçues.
        fd = proc.stdout.fileno()
        pending = b""
        eof = False
        while not eof:
            ready, _, _ = select.select([fd], [], [], 0.4)
            if ready:
                chunk = os.read(fd, 65536)
                if not chunk:
                    eof = True
                    chunk = b"\n"
                pending += chunk
                *lines, pending = pending.split(b"\n")
                for raw in lines:
                    line = raw.decode("utf-8", "replace") + "\n"
                    if HEADER_RE.match(line) and buf:
                        flush()
                    buf.append(line)
            elif buf:
                # Rien de nouveau depuis 0,4 s : le message est complet.
                flush()
        flush()
        proc.wait()
        log("dbus-monitor (%s) s'est arrêté, relance dans 5 s" % name)
        time.sleep(5)


def dbus_send(bus, dest, path, method, *args, timeout=3):
    cmd = ["dbus-send", "--" + bus, "--print-reply",
           "--reply-timeout=%d" % (timeout * 1000),
           "--dest=" + dest, path, method] + list(args)
    try:
        out = subprocess.run(cmd, capture_output=True, text=True,
                             timeout=timeout + 2).stdout
    except Exception:
        return None
    msgs = list(split_messages(out.splitlines()))
    if not msgs:
        return None
    return parse_message(msgs[0])[1]


