SPEAKER = None
BUTTON = None


def stop_reading():
    """Interrompt la lecture en cours et oublie ce qui attendait (dont la
    suite du résumé). La musique mise en pause reprend ensuite, quand le
    lecteur de Notivox constate qu'il n'a plus rien à dire."""
    SUMMARY_RUN[0] += 1
    SUMMARY_BUSY[0] = False
    SPEAKER.cancel("summary")
    SPEAKER.cancel(None)
    SPEAKER.interrupt()


def write_status(pool):
    out, device = audio_route()
    data = {
        "version": VERSION, "pid": os.getpid(), "time": int(time.time()),
        "output": out, "device": device, "blocked": blocked_reason(),
        "quiet_hours": in_quiet_hours(),
        "voices": sorted(installed_voices()),
        "piper": os.path.exists(os.path.join(PIPER_DIR, "piper")),
        "last_spoken": SPEAKER.last_spoken if SPEAKER else "",
        "last_error": SPEAKER.last_error if SPEAKER else "",
    }
    try:
        write_json(STATUS_FILE, data)
    except Exception as exc:
        dbg("statut non écrit :", exc)


def migrate(cfg):
    """Corrige les réglages écrits par une version précédente. Renvoie
    True si quelque chose a changé."""
    changed = False
    audio = cfg.setdefault("audio", {})
    # 1.0.0 et 1.0.1 : la voix des appels sortait sur le haut-parleur.
    if audio.get("call_props") == "media.name=notiftone":
        audio["call_props"] = DEFAULT_CONFIG["audio"]["call_props"]
        changed = True
    # 1.0.5 : plus d'attente fixe avant la première annonce d'appel.
    calls = cfg.setdefault("calls", {})
    if calls.get("first_delay") == 1.5:
        calls["first_delay"] = 0
        changed = True
    # 1.4.0 : tout se règle par application (arrivée et résumé) ; les
    # réglages par famille disparaissent.
    sm = cfg.get("summary", {})
    for k in ("types", "modes", "detail"):
        if k in sm:
            sm.pop(k)
            changed = True
    # 1.5.0 : le lieu de la météo garde son nom court (pour la zone de
    # saisie) et son nom complet (pour l'étiquette).
    place = sm.get("place")
    if isinstance(place, dict) and place.get("name") and \
            not place.get("label"):
        place["label"] = place["name"]
        place["name"] = place["name"].split(",")[0].strip()
        changed = True
    if "new_apps_default" in cfg:
        cfg.pop("new_apps_default")
        changed = True
    for app, a in list(cfg.get("apps", {}).items()):
        if not isinstance(a, dict):
            continue
        if "read" in a:
            content = a.pop("content", "full")
            a["arrival"] = ("titles" if content in ("title", "app")
                            else "full") if a.pop("read") else "ignore"
            changed = True
        a.pop("content", None)
        if a.get("summary") == "none":
            a["summary"] = "ignore"
            changed = True
        elif a.get("summary") == "family":
            a.pop("summary")
            changed = True
    return changed


def main():
    global CFG, STATE, SPEAKER, SEEN, BUTTON
    if "--version" in sys.argv:
        print(VERSION)
        return
    if len(sys.argv) >= 3 and sys.argv[1] == "--lookup":
        CFG = read_json(CONFIG_FILE, DEFAULT_CONFIG)
        CFG["debug"] = True
        name = lookup_contact(sys.argv[2])
        rows = _contacts["rows"] or []
        print("numéros lus dans le carnet :", len(rows))
        if _contacts.get("error"):
            print("dernière erreur :", _contacts["error"])
        print("nom trouvé :", name or "(aucun)")
        if not name:
            try:
                import sqlite3
                db = sqlite3.connect(os.path.join(CACHE_DIR, "contacts.db"))
                for t, cols in contacts_schema(db).items():
                    print("  %s : %s" % (t, ", ".join(cols)))
                db.close()
            except Exception as exc:
                print("structure illisible :", exc)
        return
    if len(sys.argv) >= 2 and sys.argv[1] == "--events":
        CFG = read_json(CONFIG_FILE, DEFAULT_CONFIG)
        try:
            events = read_events()
        except Exception as exc:
            print("lecture impossible :", exc)
            try:
                import sqlite3
                db = sqlite3.connect(os.path.join(CACHE_DIR,
                                                  "notifications.db"))
                for t in ("notifications", "hints"):
                    print("  %s : %s" % (t, ", ".join(_columns(db, t))))
            except Exception:
                pass
            return
        print("%d notifications dans la Vue Événements :" % len(events))
        for e in events:
            st = app_setting(e["app"], e["category"])
            print("  [%d] arrivée %s, résumé %s | %s | %s : %s%s" % (
                e["id"], st["arrival"], st["summary"],
                e["app"], e["category"] or "-",
                (e["summary"] + " / " + e["body"])[:70],
                "" if e["removable"] else " (non effaçable)"))
        print("\nRésumé qui serait lu :")
        beep = CFG.get("summary", {}).get("beep", True)
        for p in build_summary(events, CFG.get("language", "fr")):
            if p[0] == "pause":
                print("  (courte pause)")
            elif p[0] == "sep":
                print("  (bip)" if beep else "  (courte pause)")
            else:
                print("  [%s]%s %s" % (p[2], " (efface %s)" % p[3] if p[3]
                                       and CFG.get("summary", {}).get(
                                           "clear_after") else "", p[1]))
        return
    if len(sys.argv) >= 3 and sys.argv[1] == "--play":
        device = None
        props = []
        for a in sys.argv[3:]:
            if a.startswith("--device="):
                device = a.split("=", 1)[1]
            elif "=" in a:
                props.append(a.split("=", 1))
        sys.exit(play_with_libpulse(sys.argv[2], props, device))
    if os.path.exists(os.path.join(CONF_DIR, "service-disabled")) and \
            "--force" not in sys.argv:
        log("service désactivé dans les réglages : arrêt")
        return
    log("démarrage, version", VERSION)
    for d in (CONF_DIR, VOICE_DIR, CACHE_DIR):
        os.makedirs(d, exist_ok=True)
    cfg_w = Watched(CONFIG_FILE, DEFAULT_CONFIG)
    st_w = Watched(STATE_FILE, DEFAULT_STATE)
    CFG = cfg_w.load()
    if os.path.exists(CONFIG_FILE) and migrate(CFG):
        write_json(CONFIG_FILE, CFG)
        log("réglages mis à jour pour cette version")
    cfg_w.changed()
    STATE = st_w.load()
    st_w.changed()
    if not os.path.exists(CONFIG_FILE):
        write_json(CONFIG_FILE, CFG)
        cfg_w.changed()
    SEEN = read_json(SEEN_FILE, {})
    for name in os.listdir(CACHE_DIR):
        if name.startswith("say-") and name.endswith(".wav"):
            try:
                os.unlink(os.path.join(CACHE_DIR, name))
            except OSError:
                pass

    pool = PiperPool()
    SPEAKER = Speaker(pool)
    SPEAKER.start()
    BUTTON = MprisButton(on_stop=stop_reading, on_next=lambda:
                         SPEAKER.interrupt())
    BUTTON.start()

    def stop(*_):
        pool.stop()
        if SEEN_DIRTY[0]:
            write_json(SEEN_FILE, SEEN)
        os._exit(0)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    threading.Thread(target=monitor, daemon=True, args=(
        "session",
        ["type='method_call',interface='org.freedesktop.Notifications',"
         "member='Notify'",
         "type='signal',interface='%s'" % CONTROL_IFACE,
         "type='method_call',interface='org.mpris.MediaPlayer2.Player'"],
        on_session_message, "notifications")).start()
    threading.Thread(target=monitor, daemon=True, args=(
        OFONO_BUS,
        ["type='signal',interface='org.ofono.VoiceCallManager'",
         "type='signal',interface='org.ofono.VoiceCall'"],
        on_ofono_message, "appels")).start()

    threading.Thread(target=headset_watch, daemon=True).start()

    last_status = last_seen = last_clean = 0
    while True:
        time.sleep(0.5)
        now = time.time()
        if cfg_w.changed():
            CFG = cfg_w.load()
            dbg("réglages relus")
        if st_w.changed():
            STATE = st_w.load()
            dbg("état relu :", STATE)
        with CALLS_LOCK:
            for c in CALLS.values():
                c.pop("pending", None)
        cc = CFG.get("calls", {})
        first = float(cc.get("first_delay", 1.5))
        interval = max(2.0, float(cc.get("interval", 6)))
        repeat = max(1, int(cc.get("repeat", 3)))
        with CALLS_LOCK:
            due = [p for p, c in CALLS.items()
                   if c["state"] in ("incoming", "waiting")
                   and c.get("sched", 0) < repeat
                   and now >= c["since"] + first + c.get("sched", 0) *
                   interval]
            for p in due:
                CALLS[p]["sched"] = CALLS[p].get("sched", 0) + 1
        for p in due:
            threading.Thread(target=announce_call, args=(p,),
                             daemon=True).start()
        if now - last_status > 5:
            write_status(pool)
            last_status = now
        if SEEN_DIRTY[0] and now - last_seen > 10:
            SEEN_DIRTY[0] = False
            try:
                write_json(SEEN_FILE, SEEN)
            except Exception as exc:
                log("liste des applications non écrite :", exc)
            last_seen = now
        if now - last_clean > 30:
            # La voix de la langue principale reste chargée : une annonce
            # d'appel n'attend pas le chargement du modèle.
            pool.cleanup(keep=choose_voice(CFG.get("language", "fr")))
            last_clean = now


if __name__ == "__main__":
    main()
