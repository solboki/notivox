def migrate(cfg):
    """Corrige les réglages écrits par une version précédente. Renvoie
    True si quelque chose a changé."""
    changed = False
    audio = cfg.setdefault("audio", {})
    # 1.0.0 et 1.0.1 : la voix des appels sortait sur le haut-parleur.
    if audio.get("call_props") == "media.name=notiftone":
        audio["call_props"] = DEFAULT_CONFIG["audio"]["call_props"]
        changed = True
    # 1.0.5 : plus d'attente fixe avant la première annonce d'appel.
    calls = cfg.setdefault("calls", {})
    if calls.get("first_delay") == 1.5:
        calls["first_delay"] = 0
        changed = True
    sm = cfg.get("summary", {})
    if isinstance(sm.get("types"), dict):
        modes = sm.setdefault("modes", dict(DEFAULT_CONFIG["summary"]["modes"]))
        for fam, on in sm.pop("types").items():
            if not on:
                modes[fam] = "none"
        changed = True
    return changed


