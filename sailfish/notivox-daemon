SUMMARY_TYPES = ("messages", "calls", "email", "calendar", "system", "other")
LAST_CALL_END = [0.0]
_last_auto = {"ids": None, "time": 0.0}


def notification_type(app, category):
    """Famille d'une notification, d'après sa catégorie (et à défaut le nom
    de l'application qui l'a publiée)."""
    c = (category or "").lower()
    a = (app or "").lower()
    if c.startswith("x-nemo.call") or "call.missed" in c:
        return "calls"
    if c.startswith(("x-nemo.messaging", "im.")) or c in ("im", "msg"):
        return "messages"
    if c.startswith(("x-nemo.email", "email")):
        return "email"
    if c.startswith(("x-nemo.calendar", "x-nemo.alarm", "x-nemo.reminder",
                     "x-nemo.organizer")) or c in ("event", "reminder",
                                                  "alarm"):
        return "calendar"
    if c.startswith(("x-nemo.system", "x-nemo.battery", "x-nemo.transfer",
                     "x-nemo.software-update", "x-nemo.connectivity",
                     "x-nemo.general", "x-nemo.ssu", "x-nemo.usb",
                     "x-nemo.storage", "device", "network", "transfer",
                     "presence")):
        return "system"
    if a in ("messages", "commhistoryd"):
        return "messages"
    if a in ("téléphone", "phone", "voicecall-ui"):
        return "calls"
    return "other"


def events_db_path():
    """Copie fraîche de la base des notifications, ou None."""
    if EVENTS_DB:
        return EVENTS_DB
    if not os.path.exists(HELPER):
        return None
    try:
        subprocess.run([HELPER, "notifications"], timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as exc:
        dbg("copie des notifications impossible :", exc)
        return None
    path = os.path.join(CACHE_DIR, "notifications.db")
    return path if os.path.exists(path) else None


def read_events():
    """Notifications présentes dans la Vue Événements, de la plus ancienne
    à la plus récente : liste de dict (id, app, summary, body, category,
    removable, type).

    Sailfish (lipstick) garde ces notifications dans une base SQLite. Il
    l'écrit avec quelques secondes de retard : une notification arrivée
    juste avant le résumé peut manquer."""
    path = events_db_path()
    if not path:
        raise RuntimeError("base des notifications introuvable")
    import sqlite3
    db = sqlite3.connect("file:%s" % path, uri=True, timeout=2)
    try:
        cols = _columns(db, "notifications")
        if "id" not in cols or "summary" not in cols:
            raise RuntimeError("table des notifications inattendue : %s"
                               % cols)
        hints = {}
        if "hint" in _columns(db, "hints"):
            for nid, hint, value in db.execute(
                    "SELECT id, hint, value FROM hints"):
                hints.setdefault(nid, {})[str(hint)] = value
        names = [c for c in ("app_name", "explicit_app_name",
                             "disambiguated_app_name") if c in cols]
        rows = db.execute("SELECT id, summary, body, %s FROM notifications "
                          "ORDER BY id" % ", ".join(names or ["''"]))
        out = []
        for row in rows:
            nid, summary, body = row[0], row[1] or "", row[2] or ""
            named = dict(zip(names, row[3:]))
            h = hints.get(nid, {})
            if str(h.get("transient", "")).lower() in ("true", "1"):
                continue
            app = (named.get("explicit_app_name") or
                   named.get("disambiguated_app_name") or
                   named.get("app_name") or "").strip()
            summary = clean(str(summary or h.get("x-nemo-preview-summary")
                                or ""))
            body = clean(str(body or h.get("x-nemo-preview-body") or ""))
            if not summary and not body:
                continue
            category = str(h.get("category") or "")
            removable = str(h.get("x-nemo-user-removable", "true")).lower() \
                not in ("false", "0")
            out.append({"id": int(nid), "app": app or "?",
                        "summary": summary, "body": body,
                        "category": category, "removable": removable,
                        "type": notification_type(app, category)})
        return out
    finally:
        db.close()


SUMMARY_MODES = ("none", "count", "full")


def summary_mode(app, family):
    """Mode d'une application dans le résumé : son réglage propre, sinon
    celui de sa famille."""
    sc = CFG.get("summary", {})
    own = CFG.get("apps", {}).get(app, {}).get("summary")
    if own in SUMMARY_MODES:
        return own
    mode = sc.get("modes", {}).get(family)
    return mode if mode in SUMMARY_MODES else "count"


def sp(key, lang):
    return phrase("s_" + key, lang)


def join_names(names, lang):
    if len(names) <= 1:
        return "".join(names)
    return "%s %s %s" % (", ".join(names[:-1]), sp("and", lang), names[-1])


def de_app(app, lang):
    """« de Facebook », « d'E-mail » : élision française devant une
    voyelle."""
    if lang == "fr" and app[:1].lower() in "aeéèêiîoôuyh":
        return "d'", app
    return "de ", app


def date_phrase(lang, now=None):
    t = time.localtime(now or time.time())
    hello = sp("evening" if t.tm_hour >= 18 else "hello", lang)
    wd = sp("weekdays", lang).split()[t.tm_wday]
    mo = sp("months", lang).split()[t.tm_mon - 1]
    day = t.tm_mday
    if lang == "fr" and day == 1:
        day = "1er"
    date = sp("date", lang).format(weekday=wd, day=day, month=mo)
    h12 = t.tm_hour % 12 or 12
    ampm = "a.m." if t.tm_hour < 12 else "p.m."
    key = "time0" if t.tm_min == 0 else "time"
    hour = sp(key, lang).format(h=t.tm_hour, m=t.tm_min, h12=h12, ampm=ampm)
    return "%s %s %s" % (hello, date, hour)


def build_summary(events, lang, now=None):
    """Prépare le résumé, sous forme d'une liste d'éléments :
      ("say", texte, langue, ids effaçables après lecture)
      ("pause",) courte pause ; ("sep",) bip ou pause entre deux messages.

    Forme : salutation, date et heure ; total et applications ; pour chaque
    application, son nombre de notifications, puis, en mode « tout lire »,
    chacune numérotée ; formule de fin."""
    sc = CFG.get("summary", {})
    groups, order = {}, []
    for e in events:
        mode = summary_mode(e["app"], e["type"])
        if mode == "none":
            continue
        if e["app"] not in groups:
            groups[e["app"]] = {"mode": mode, "items": []}
        groups[e["app"]]["items"].append(e)
    # Applications les plus récemment actives d'abord, comme dans la Vue
    # Événements ; dans chaque application, ordre chronologique.
    order = sorted(groups, key=lambda a: -max(e["id"] for e in
                                              groups[a]["items"]))
    out = [("say", date_phrase(lang, now), lang, []), ("pause",)]
    total = sum(len(groups[a]["items"]) for a in order)
    if not total:
        out.append(("say", sp("none", lang) + " " +
                    sp("end", lang).split(".")[-2].strip() + ".", lang, []))
        return out
    out.append(("say", sp("total_1" if total == 1 else "total_n", lang)
                .format(n=total, apps=join_names(order, lang),
                        de=de_app(order[0], lang)[0].strip())
                .replace("d' ", "d'"), lang, []))
    out.append(("pause",))
    limit = max(1, int(sc.get("max_items", 30) or 30))
    maxc = int(CFG.get("max_chars", 300) or 300)
    told = 0
    for app in order:
        g = groups[app]["items"]
        de, name = de_app(app, lang)
        out.append(("say", sp("group_1" if len(g) == 1 else "group_n", lang)
                    .format(n=len(g), app=name, de=de.strip())
                    .replace("d' ", "d'"), lang, []))
        out.append(("pause",))
        if groups[app]["mode"] != "full":
            continue
        content = app_setting(app).get("content", "full") \
            if app in CFG.get("apps", {}) else "full"
        for i, e in enumerate(g, 1):
            if told >= limit:
                break
            sender, body = e["summary"], e["body"]
            if content == "title" or content == "app":
                body = ""
            if sender.strip().lower() == app.strip().lower():
                sender = ""
            text = ". ".join(x for x in (sender, body) if x) or app
            if len(text) > maxc:
                text = text[:maxc].rsplit(" ", 1)[0] + "…"
            if len(g) > 1:
                text = sp("item", lang).format(i=i, text=text)
            item_lang = lang
            if CFG.get("detect_language", True):
                item_lang = detect_language(e["summary"] + " " + e["body"],
                                            candidate_langs(), lang)
            if i > 1:
                out.append(("sep",))
            out.append(("say", text, item_lang,
                        [e["id"]] if e["removable"] else []))
            told += 1
        out.append(("pause",))
    full_total = sum(len(groups[a]["items"]) for a in order
                     if groups[a]["mode"] == "full")
    if told < full_total:
        out.append(("say", sp("more", lang).format(n=full_total - told),
                    lang, []))
        out.append(("pause",))
    out.append(("say", sp("end", lang), lang, []))
    return out


def sound_file(kind):
    """Fichier WAV d'une courte pause ou d'un bip doux, créé au besoin."""
    path = os.path.join(CACHE_DIR, "%s.wav" % kind)
    if os.path.exists(path):
        return path
    import math
    rate = 22050
    frames = array("h")
    if kind == "pause":
        frames.extend([0] * int(rate * 0.7))
    else:
        n = int(rate * 0.12)
        for i in range(n):
            env = min(1.0, i / 300.0, (n - i) / 600.0)
            frames.append(int(6000 * env * math.sin(2 * math.pi * 880 * i /
                                                     rate)))
        frames.extend([0] * int(rate * 0.25))
        frames = array("h", [0] * int(rate * 0.2)) + frames
    if sys.byteorder == "big":
        frames.byteswap()
    os.makedirs(CACHE_DIR, exist_ok=True)
    with wave.open(path, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(frames.tobytes())
    return path


def close_notifications(ids):
    """Efface des notifications de la Vue Événements. Sailfish permet à
    toute application d'effacer une notification marquée comme effaçable
    par l'utilisateur, ce qui est le cas par défaut."""
    for nid in ids:
        r = dbus_send("session", "org.freedesktop.Notifications",
                      "/org/freedesktop/Notifications",
                      "org.freedesktop.Notifications.CloseNotification",
                      "uint32:%d" % int(nid))
        dbg("notification %d effacée" % nid if r is not None
            else "notification %d : effacement sans réponse" % nid)


def speak_summary(manual=False, force=False):
    """Lit le résumé de la Vue Événements.

    manual : demandé explicitement (commande, bouton) ; il est alors lu
    même sans nouveauté. force : True pour le lire quoi qu'il arrive,
    "speaker" pour accepter le haut-parleur faute d'écouteurs.

    Chaque phrase est fabriquée puis aussitôt mise dans la file de
    lecture : la voix commence à parler pendant que la suite se prépare."""
    lang = CFG.get("language", "fr")
    if force is not True and not may_speak(speaker_ok=force == "speaker"):
        dbg("résumé non lu :", blocked_reason(speaker_ok=force ==
                                              "speaker"))
        return
    try:
        events = read_events()
    except Exception as exc:
        log("résumé impossible :", exc)
        events = []
    parts = build_summary(events, lang)
    if not manual:
        if not any(p[0] == "say" and p[3] for p in parts) and \
                len(parts) <= 3:
            dbg("résumé automatique : rien à lire")
            return
        shown = sorted(e["id"] for e in events)
        # Même liste lue il y a moins de 30 minutes : on ne la répète pas.
        if _last_auto["ids"] == shown and \
                time.time() - _last_auto["time"] < 1800:
            dbg("résumé automatique : rien de nouveau depuis le dernier")
            return
        _last_auto["ids"], _last_auto["time"] = shown, time.time()
    sc = CFG.get("summary", {})
    clear = sc.get("clear_after", False)
    beep = sc.get("beep", True)
    d = os.path.join(CACHE_DIR, "summary")
    os.makedirs(d, exist_ok=True)
    log("résumé : %d notifications, %d éléments" % (len(events),
                                                     len(parts)))
    SPEAKER.cancel("summary")
    for n, p in enumerate(parts):
        if p[0] in ("pause", "sep"):
            kind = "beep" if p[0] == "sep" and beep else "pause"
            SPEAKER.say(("wav", sound_file(kind), "son", kind), prio=3,
                        tag="summary", force=force)
            continue
        _k, text, plang, pids = p
        try:
            path = os.path.join(d, "%03d.wav" % n)
            wav, voice = SPEAKER.render(text, plang, path=path)
        except Exception as exc:
            log("phrase du résumé non préparée :", exc)
            continue
        done = None
        if clear and pids:
            done = (lambda x=tuple(pids): close_notifications(x))
        # Priorité 3 : après un appel, avant les nouvelles notifications.
        SPEAKER.say(("wav", wav, voice or "espeak", text), lang=plang,
                    prio=3, tag="summary", force=force, done=done)


def headset_watch():
    """Lance le résumé quand des écouteurs deviennent la sortie son.

    On suit les événements du serveur son (pactl subscribe) plutôt que de
    l'interroger en boucle. Les changements dus à un appel (le casque
    Bluetooth est éteint pendant la sonnerie puis rallumé) sont ignorés."""
    state = {"out": audio_output(), "pending": 0.0}

    def check():
        forget_route()
        new = audio_output()
        old, state["out"] = state["out"], new
        if new not in ("bluetooth", "wired") or old in ("bluetooth",
                                                         "wired"):
            return
        if CALLS or time.time() - LAST_CALL_END[0] < 60:
            dbg("écouteurs : changement lié à un appel, pas de résumé")
            return
        if not CFG.get("summary", {}).get("on_headset", False):
            return
        if blocked_reason():
            dbg("résumé à la connexion non lu :", blocked_reason())
            return
        dbg("écouteurs connectés (%s) : résumé" % new)
        speak_summary(manual=False)

    env = dict(os.environ, LC_ALL="C", LANG="C")
    while True:
        if not shutil.which("pactl"):
            time.sleep(5)
            check()
            continue
        try:
            proc = subprocess.Popen(["pactl", "subscribe"], env=env,
                                    stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True)
        except OSError:
            time.sleep(30)
            continue
        for line in proc.stdout:
            if re.search(r"'(new|change|remove)' on (sink|card) ", line):
                # On laisse le casque s'installer avant de regarder.
                if not state["pending"]:
                    state["pending"] = time.time()
                    threading.Timer(3.0, lambda: (state.update(pending=0.0),
                                                  check())).start()
        proc.wait()
        time.sleep(5)


