def log(*args):
    """Écrit dans le terminal et dans ~/.cache/notivox/notivox.log : sur
    Sailfish, le journal du système n'est pas lisible par l'utilisateur."""
    line = " ".join(str(a) for a in args)
    with _log_lock:
        print("notivox:", line, file=sys.stderr, flush=True)
        try:
            if os.path.exists(LOG_FILE) and \
                    os.path.getsize(LOG_FILE) > 256 * 1024:
                os.replace(LOG_FILE, LOG_FILE + ".1")
            with open(LOG_FILE, "a", encoding="utf-8") as f:
                f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + line + "\n")
        except OSError:
            pass


def dbg(*args):
    if CFG.get("debug") or os.environ.get("NOTIVOX_DEBUG") == "1":
        log("[debug]", *args)


