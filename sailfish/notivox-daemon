def hm(s):
    try:
        h, m = s.split(":")
        return int(h) * 60 + int(m)
    except Exception:
        return None


def in_quiet_hours(now=None):
    sch = CFG.get("schedule", {})
    if not sch.get("enabled"):
        return False
    t = time.localtime(now or time.time())
    minute = t.tm_hour * 60 + t.tm_min
    today = t.tm_wday
    yesterday = (today - 1) % 7
    for r in sch.get("rules", []):
        a, b = hm(r.get("start", "")), hm(r.get("end", ""))
        days = r.get("days", list(range(7)))
        if a is None or b is None or a == b:
            continue
        if a < b:
            if today in days and a <= minute < b:
                return True
        else:
            # Plage à cheval sur minuit : 22:00 -> 07:00
            if (today in days and minute >= a) or \
               (yesterday in days and minute < b):
                return True
    return False


CALLS = {}        # chemin oFono -> état et informations de l'appel
CALLS_LOCK = threading.Lock()


def in_call():
    with CALLS_LOCK:
        return any(c["state"] in ("active", "dialing", "alerting", "held")
                   for c in CALLS.values())


def blocked_reason(call=False, speaker_ok=False):
    """Renvoie la raison pour laquelle il ne faut pas parler, ou "".
    speaker_ok : le haut-parleur est permis faute d'écouteurs."""
    if not STATE.get("enabled", True):
        return "désactivé"
    if STATE.get("pause_until", 0) > time.time():
        return "en pause"
    if in_quiet_hours() and (not call or
                             CFG.get("calls", {}).get("obey_schedule")):
        return "plage de silence"
    if not call and CFG.get("skip_during_call") and in_call():
        return "appel en cours"
    if CFG.get("require_headphones", True):
        out = audio_output()
        if out == "speaker" and not speaker_ok and not (
                call and CFG.get("calls", {}).get("speaker_fallback")):
            return "pas d'écouteurs"
        if out == "unknown" and not speaker_ok and \
                not CFG.get("speak_if_output_unknown"):
            return "sortie audio inconnue"
    if CFG.get("respect_silent_profile") and silent_profile():
        return "profil silencieux"
    return ""


def may_speak(call=False, speaker_ok=False):
    return blocked_reason(call, speaker_ok) == ""


