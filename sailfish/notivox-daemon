        for e in events:
            print("  [%d] %s (%s) | %s | %s : %s%s" % (
                e["id"], e["type"], summary_mode(e["app"], e["type"]),
                e["app"], e["category"] or "-",
                (e["summary"] + " / " + e["body"])[:70],
                "" if e["removable"] else " (non effaçable)"))
        print("\nRésumé qui serait lu :")
        beep = CFG.get("summary", {}).get("beep", True)
        for p in build_summary(events, CFG.get("language", "fr")):
            if p[0] == "pause":
                print("  (courte pause)")
            elif p[0] == "sep":
                print("  (bip)" if beep else "  (courte pause)")
            else:
                print("  [%s]%s %s" % (p[2], " (efface %s)" % p[3] if p[3]
                                       and CFG.get("summary", {}).get(
                                           "clear_after") else "", p[1]))
        return
