SEEN = {}
SEEN_DIRTY = [False]
RECENT = {}       # empreinte du texte -> heure, pour éviter les doublons
RECENT_LOCK = threading.Lock()
TAG_RE = re.compile(r"<[^>]+>")


def clean(s):
    s = TAG_RE.sub(" ", s or "")
    s = s.replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">")
    s = s.replace("&quot;", '"').replace("&#39;", "'")
    # Les liens et les longues suites de symboles ne se lisent pas bien.
    s = re.sub(r"(https?://|www\.)\S+", " ", s)
    s = re.sub(r"[☀-➿\U0001F000-\U0001FAFF️]", " ", s)
    return re.sub(r"\s+", " ", s).strip()


APP_DEFAULT_FULL = ("messages", "téléphone", "phone", "appels", "calls",
                    "commhistoryd", "voicecall-ui")


def default_mode(app, category=""):
    """Mode d'une application jamais réglée : « full » pour Messages et les
    appels, « ignore » pour toutes les autres."""
    c = (category or "").lower()
    if (app or "").strip().lower() in APP_DEFAULT_FULL or \
            c.startswith(("x-nemo.call", "x-nemo.messaging.sms",
                          "x-nemo.messaging.mms")):
        return "full"
    return "ignore"


def app_setting(app, category=""):
    """Réglages effectifs d'une application (les valeurs absentes prennent
    leur valeur par défaut)."""
    if not category:
        category = SEEN.get(app, {}).get("category", "")
    d = default_mode(app, category)
    base = {"arrival": d, "summary": d, "speaker": False, "lang": "auto"}
    own = CFG.get("apps", {}).get(app)
    if isinstance(own, dict):
        for k in base:
            if own.get(k) is not None:
                base[k] = own[k]
    if base["arrival"] not in ("ignore", "titles", "full"):
        base["arrival"] = d
    if base["summary"] not in ("ignore", "count", "titles", "full"):
        base["summary"] = d
    return base


def first_sentence(text, limit=90):
    m = re.match(r"(.+?[.!?…])(\s|$)", text or "")
    t = m.group(1) if m else (text or "")
    if len(t) > limit:
        t = t[:limit].rsplit(" ", 1)[0] + "…"
    return t


def title_of(app, summary, body):
    """Titre d'une notification : son expéditeur ou son objet. Quand le
    titre n'est que le nom de l'application (« Facebook »), on prend la
    première phrase du texte."""
    if summary and summary.strip().lower() != (app or "").strip().lower():
        return summary
    return first_sentence(body) or app


def remember_app(app, sample, hints):
    s = SEEN.get(app, {"count": 0})
    s["count"] = s.get("count", 0) + 1
    s["last"] = int(time.time())
    s["sample"] = sample[:80]
    cat = hints.get("category") if isinstance(hints, dict) else None
    if cat:
        s["category"] = str(cat)
    SEEN[app] = s
    SEEN_DIRTY[0] = True


def player_status(name):
    st = dbus_send("session", name, MPRIS_PATH,
                   "org.freedesktop.DBus.Properties.Get",
                   "string:org.mpris.MediaPlayer2.Player",
                   "string:PlaybackStatus")
    return str(st[0]) if st else ""


def mute_media_streams():
    """Rend muets les flux audio de musique qui jouent encore (ceux qu'on
    n'a pas pu mettre en pause). Renvoie leurs numéros."""
    if not shutil.which("pactl"):
        return []
    env = dict(os.environ, LC_ALL="C", LANG="C")
    try:
        out = subprocess.run(["pactl", "list", "sink-inputs"],
                             capture_output=True, text=True, timeout=4,
                             env=env).stdout
    except Exception:
        return []
    muted = []
    for block in re.split(r"\n(?=Sink Input #)", out):
        m = re.match(r"Sink Input #(\d+)", block.strip())
        if not m:
            continue
        role = re.search(r'media\.role = "([^"]*)"', block)
        role = role.group(1) if role else ""
        if 'media.title = "Notivox"' in block or \
                re.search(r"^\s*Corked: yes", block, re.M) or \
                re.search(r"^\s*Mute: yes", block, re.M) or \
                role in ("phone", "ringtone", "alarm", "notification",
                         "event", "voiceui", "feedback", "systemsound"):
            continue
        if subprocess.run(["pactl", "set-sink-input-mute", m.group(1), "1"],
                          timeout=4, env=env).returncode == 0:
            muted.append(m.group(1))
    if muted:
        log("flux audio rendus muets pendant la lecture :", muted)
    return muted


def unmute_streams(ids):
    for i in ids:
        subprocess.run(["pactl", "set-sink-input-mute", i, "0"], timeout=4,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def on_player_command(head):
    """Un ordre (lecture, pause…) est envoyé à un lecteur multimédia.

    Sailfish envoie le bouton du casque à un lecteur qu'il choisit, et non
    à Notivox. Un ordre qui passe pendant que Notivox parle signifie donc
    que l'on a appuyé sur le bouton : Notivox se tait, et la lecture qui
    avait été mise en pause reprend. Si l'appui a relancé un autre lecteur
    (qui ne jouait pas avant), celui-ci est remis en pause."""
    if not BUTTON or not BUTTON.owned or \
            not CFG.get("headset_button", True):
        return
    if time.time() < BUTTON.ignore_until:
        return      # nos propres ordres de pause et de reprise
    dest, member = head.get("destination", ""), head.get("member", "")
    if member not in ("Play", "PlayPause", "Pause", "Stop", "Next",
                      "Previous") or dest in (MPRIS_NAME, BUTTON.unique):
        return
    before = BUTTON.states.get(dest, "")
    log("bouton du casque (ordre %s à %s, alors %s) : lecture interrompue"
        % (member, dest, before or "état inconnu"))
    stop_reading()

    def settle():
        time.sleep(0.3)
        BUTTON.ignore_until = time.time() + 1.5
        names = {u: n for n, (u, _s) in BUTTON.player_states().items()}
        name = names.get(dest, dest)
        was_paused_by_us = name in BUTTON.paused
        if not was_paused_by_us and before != "Playing" and \
                player_status(name) == "Playing":
            dbus_send("session", name, MPRIS_PATH,
                      "org.mpris.MediaPlayer2.Player.Pause")
            dbg("lecteur %s remis en pause" % name)
        BUTTON.resume_others()
        BUTTON.set_active(False)
    threading.Thread(target=settle, daemon=True).start()


def on_session_message(head, vals):
    if head.get("interface") == CONTROL_IFACE:
        on_control(head.get("member", ""), vals)
        return
    if head.get("interface") == "org.mpris.MediaPlayer2.Player":
        if "method call" in head.get("kind", ""):
            on_player_command(head)
        return
    if head.get("member") != "Notify" or "method call" not in head["kind"]:
        return
    if len(vals) < 7:
        return
    app, replaces, _icon, summary, body, _actions, hints = vals[:7]
    hints = hints if isinstance(hints, dict) else {}
    app = str(app or "").strip()
    summary = clean(str(hints.get("x-nemo-preview-summary") or summary or ""))
    body = clean(str(hints.get("x-nemo-preview-body") or body or ""))
    dbg("Notify app=%r cat=%r résumé=%r" % (app, hints.get("category", ""),
                                             summary[:40]))
    if not app or app in CFG.get("ignored_apps", []):
        return
    if not summary and not body:
        return
    remember_app(app, (summary + " : " + body).strip(" :"), hints)
    st = app_setting(app, str(hints.get("category") or ""))
    mode = st["arrival"]
    if mode == "ignore":
        return
    key = (app, summary, body)
    now = time.time()
    with RECENT_LOCK:
        for k in [k for k, t in RECENT.items() if now - t > 120]:
            del RECENT[k]
        if key in RECENT:
            dbg("doublon ignoré")
            return
        RECENT[key] = now
    speaker_ok = bool(st.get("speaker"))
    reason = blocked_reason(call=False, speaker_ok=speaker_ok)
    if reason:
        dbg("notification non lue (%s)" % reason)
        return
    parts = []
    if CFG.get("announce_app", True):
        parts.append(app)
    if mode == "titles":
        t = title_of(app, summary, body)
        if t and t != app:
            parts.append(t)
    else:
        if summary and summary.strip().lower() != app.strip().lower():
            parts.append(summary)
        if body:
            parts.append(body)
    if not parts:
        parts.append(app)
    text = ". ".join(p.rstrip(".") for p in parts if p)
    limit = int(CFG.get("max_chars", 300) or 300)
    if len(text) > limit:
        text = text[:limit].rsplit(" ", 1)[0] + "…"
    lang = st.get("lang", "auto")
    if lang == "auto":
        default = CFG.get("language", "fr")
        if CFG.get("detect_language", True):
            lang = detect_language(summary + " " + body, candidate_langs(),
                                   default)
        else:
            lang = default
    SPEAKER.say(text, lang=lang, prio=5,
                force="speaker" if speaker_ok else False)


def on_control(member, vals):
    global STATE
    dbg("commande reçue :", member, vals)
    st = read_json(STATE_FILE, DEFAULT_STATE)
    if member == "Enable":
        st["enabled"], st["pause_until"] = True, 0
    elif member == "Disable":
        st["enabled"] = False
    elif member == "Toggle":
        st["enabled"] = not st.get("enabled", True)
        st["pause_until"] = 0
    elif member == "Pause":
        minutes = int(vals[0]) if vals else 30
        st["pause_until"] = int(time.time() + 60 * minutes)
    elif member == "Resume":
        st["pause_until"] = 0
    elif member == "Say":
        if vals:
            text = str(vals[0])
            lang = str(vals[1]) if len(vals) > 1 and vals[1] else None
            if not lang:
                lang = detect_language(text, candidate_langs(),
                                       CFG.get("language", "fr"))
            SPEAKER.say(text, lang=lang, prio=1, force=True)
        return
    elif member == "Summary":
        # « force » (bouton des réglages) : lu quoi qu'il arrive ;
        # « speaker » (notivox-ctl events-speakers) : sur le haut-parleur
        # s'il n'y a pas d'écouteurs.
        arg = str(vals[0]) if vals else ""
        threading.Thread(target=speak_summary, daemon=True, kwargs={
            "manual": True,
            "force": True if arg == "force" else
            ("speaker" if arg == "speaker" else False)}).start()
        return
    elif member == "Stop":
        stop_reading()
        return
    elif member == "TestVoice":
        if vals and vals[0]:
            key = str(vals[0])
            lang = voice_lang(key)
            SPEAKER.say(phrase("test", lang), lang=lang, prio=1, force=True,
                        voice=key)
        return
    elif member == "Test":
        lang = str(vals[0]) if vals and vals[0] else CFG.get("language", "fr")
        SPEAKER.say(phrase("test", lang), lang=lang, prio=1, force=True)
        return
    else:
        return
    write_json(STATE_FILE, st)
    STATE = st


