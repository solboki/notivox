HEADSET_PORT_RE = re.compile(r"(headset|headphone|wired|bluetooth|usb|"
                             r"lineout|line-out)", re.I)


def pactl_sinks():
    """[(nom, port actif)] des sorties son. pactl traduit ses étiquettes
    (« Nom », « Port actif ») : on le fait donc parler anglais."""
    if not shutil.which("pactl"):
        return None
    env = dict(os.environ, LC_ALL="C", LANG="C")
    try:
        out = subprocess.run(["pactl", "list", "sinks"], capture_output=True,
                             text=True, timeout=4, env=env).stdout
    except Exception:
        return None
    if not out.strip():
        return None
    sinks = []
    for block in re.split(r"\n(?=Sink #)", out):
        name = re.search(r"^\s*Name:\s*(\S+)", block, re.M)
        port = re.search(r"^\s*Active Port:\s*(\S+)", block, re.M)
        if name:
            sinks.append((name.group(1), port.group(1) if port else ""))
    return sinks


def output_from_pactl():
    """("bluetooth" | "wired" | "speaker", sortie à utiliser) ou None.

    La sortie est toujours nommée explicitement : sur certains téléphones,
    la sortie par défaut est « sink.null », qui ne mène nulle part."""
    sinks = pactl_sinks()
    if sinks is None:
        return None
    for name, port in sinks:
        if name.startswith("bluez_sink") or "bluetooth" in port.lower():
            return ("bluetooth", name)
    for name, port in sinks:
        if port and HEADSET_PORT_RE.search(port):
            return ("wired", name)
    for name, port in sinks:
        if port and name != "sink.null":
            return ("speaker", name)
    return ("speaker", None)


A2DP_UUIDS = ("0000110b", "0000110d", "0000111e", "00001108", "00001131")


def output_from_bluez():
    vals = dbus_send("system", "org.bluez", "/",
                     "org.freedesktop.DBus.ObjectManager.GetManagedObjects")
    if not vals or not isinstance(vals[0], dict):
        return None
    for ifaces in vals[0].values():
        dev = ifaces.get("org.bluez.Device1") if isinstance(ifaces, dict) \
            else None
        if not isinstance(dev, dict) or not dev.get("Connected"):
            continue
        uuids = [str(u).lower() for u in dev.get("UUIDs", [])]
        if any(u.startswith(a) for u in uuids for a in A2DP_UUIDS):
            return "bluetooth"
    return "speaker"


_output_cache = (0.0, "unknown", None)


def audio_output():
    """Renvoie "bluetooth", "wired", "speaker" ou "unknown"."""
    return audio_route()[0]


def audio_route():
    """(type de sortie, nom de la sortie PulseAudio à viser ou None)."""
    global _output_cache
    now = time.time()
    if now - _output_cache[0] < 2:
        return _output_cache[1], _output_cache[2]
    forced = os.environ.get("NOTIVOX_FORCE_OUTPUT")
    if forced:
        res, sink = forced, None
    else:
        r = output_from_pactl()
        res, sink = r if r else (None, None)
        # BlueZ ne sert qu'en l'absence de pactl : il dit seulement qu'un
        # casque est connecté, pas qu'il peut recevoir du son. Pendant la
        # sonnerie d'un appel, le casque est connecté mais sa sortie son a
        # disparu, et le système joue tout sur le haut-parleur.
        if res is None:
            res = output_from_bluez()
    res = res or "unknown"
    _output_cache = (now, res, sink)
    return res, sink


def pactl_cards():
    """[(nom, profil actif, profils disponibles)] des cartes son."""
    if not shutil.which("pactl"):
        return []
    env = dict(os.environ, LC_ALL="C", LANG="C")
    try:
        out = subprocess.run(["pactl", "list", "cards"], capture_output=True,
                             text=True, timeout=4, env=env).stdout
    except Exception:
        return []
    cards = []
    for block in re.split(r"\n(?=Card #)", out):
        name = re.search(r"^\s*Name:\s*(\S+)", block, re.M)
        active = re.search(r"^\s*Active Profile:\s*(\S+)", block, re.M)
        profiles = set(re.findall(r"^\s+([\w-]+): .*\(sinks:", block, re.M))
        if name:
            cards.append((name.group(1), active.group(1) if active else "",
                          profiles))
    return cards


def wake_bt_headset():
    """Pendant la sonnerie d'un appel, Sailfish éteint le son du casque
    Bluetooth (profil « off ») sans rien ouvrir d'autre avant le décroché.
    On le remet en mode musique (A2DP) le temps de l'annonce ; au décroché,
    le système le passe de lui-même en mode conversation.

    Renvoie True si la sortie musique du casque est de nouveau disponible."""
    woke = False
    for name, active, profiles in pactl_cards():
        if not name.startswith("bluez_card") or active != "off" or \
                "a2dp_sink" not in profiles:
            continue
        try:
            r = subprocess.run(["pactl", "set-card-profile", name,
                                "a2dp_sink"], timeout=4,
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)
        except Exception as exc:
            dbg("bascule du casque impossible :", exc)
            continue
        dbg("casque %s remis en mode musique (code %d)" % (name, r.returncode))
        woke = woke or r.returncode == 0
    if not woke:
        return False
    # La sortie du casque met un instant à réapparaître.
    for _ in range(40):
        sinks = pactl_sinks() or []
        if any(n.startswith("bluez_sink") for n, _p in sinks):
            forget_route()
            return True
        time.sleep(0.1)
    forget_route()
    return False


def forget_route():
    """Oublie la sortie mémorisée : au début d'une sonnerie, elle change."""
    global _output_cache
    _output_cache = (0.0, "unknown", None)


def silent_profile():
    vals = dbus_send("session", "com.nokia.profiled", "/com/nokia/profiled",
                     "com.nokia.profiled.get_profile")
    return bool(vals) and vals[0] == "silent"


