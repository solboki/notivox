_contacts = {"rows": None, "time": 0}


def digits(s):
    return re.sub(r"\D", "", s or "")


def _columns(db, table):
    try:
        return [r[1] for r in db.execute("PRAGMA table_info(%s)" % table)]
    except Exception:
        return []


def contacts_schema(db):
    """Résumé lisible de la structure du carnet, pour le diagnostic."""
    tables = [r[0] for r in db.execute(
        "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")]
    return {t: _columns(db, t) for t in tables
            if t in ("Contacts", "PhoneNumbers", "DisplayLabels", "Names",
                     "Nicknames", "Organizations")}


def read_contact_rows(db):
    """(nom, numéro) pour chaque numéro du carnet.

    La structure de la base qtcontacts-sqlite a changé selon les versions
    de Sailfish : le nom affiché a quitté la table Contacts. On cherche
    donc le nom là où il se trouve, du plus au moins précis : nom affiché,
    prénom et nom, surnom, organisation."""
    phone = _columns(db, "PhoneNumbers")
    if "phoneNumber" not in phone or "contactId" not in phone:
        raise RuntimeError("table PhoneNumbers inattendue : %s" % phone)
    names = {}

    def fill(sql):
        try:
            for cid, label in db.execute(sql):
                label = " ".join(str(label or "").split())
                if label and cid not in names:
                    names[cid] = label
        except Exception as exc:
            dbg("lecture partielle du carnet :", exc)

    if "displayLabel" in _columns(db, "Contacts"):
        fill("SELECT contactId, displayLabel FROM Contacts")
    if "displayLabel" in _columns(db, "DisplayLabels"):
        fill("SELECT contactId, displayLabel FROM DisplayLabels")
    nc = _columns(db, "Names")
    if "contactId" in nc:
        parts = [c for c in ("prefix", "firstName", "middleName", "lastName",
                             "suffix") if c in nc]
        if parts:
            expr = " || ' ' || ".join("COALESCE(%s, '')" % c for c in parts)
            fill("SELECT contactId, %s FROM Names" % expr)
        if "customLabel" in nc:
            fill("SELECT contactId, customLabel FROM Names")
    if "nickname" in _columns(db, "Nicknames"):
        fill("SELECT contactId, nickname FROM Nicknames")
    if "name" in _columns(db, "Organizations"):
        fill("SELECT contactId, name FROM Organizations")
    out = []
    for cid, number in db.execute(
            "SELECT contactId, phoneNumber FROM PhoneNumbers"):
        if cid in names and number:
            out.append((names[cid], str(number)))
    if not out:
        dbg("structure du carnet :", contacts_schema(db))
    return out


def contact_rows():
    """Lit les couples (nom, numéro) du carnet d'adresses de Sailfish.

    Le carnet est réservé aux processus du groupe « privileged ». On essaie
    d'abord de le lire directement, puis on demande au petit assistant
    notivox-helper, installé avec ce droit, d'en faire une copie privée
    dans ~/.cache/notivox."""
    now = time.time()
    if _contacts["rows"] is not None and now - _contacts["time"] < 60:
        return _contacts["rows"]
    rows = None
    for attempt in ("direct", "assistant"):
        path = CONTACTS_DB
        if attempt == "assistant":
            if not os.path.exists(HELPER):
                break
            try:
                subprocess.run([HELPER, "contacts"], timeout=5,
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)
            except Exception:
                break
            path = os.path.join(CACHE_DIR, "contacts.db")
        try:
            import sqlite3
            # La copie privée s'ouvre normalement : en lecture seule, SQLite
            # refuse une base en mode WAL dont le fichier -shm manque.
            uri = ("file:%s?mode=ro" % path) if attempt == "direct" \
                else ("file:%s" % path)
            db = sqlite3.connect(uri, uri=True,
                                 timeout=1)
            try:
                rows = read_contact_rows(db)
            finally:
                db.close()
            dbg("carnet lu (%s) : %d numéros" % (attempt, len(rows)))
            break
        except Exception as exc:
            dbg("carnet illisible (%s) : %s" % (attempt, exc))
            _contacts["error"] = "%s : %s" % (attempt, exc)
    _contacts["rows"], _contacts["time"] = rows or [], now
    return _contacts["rows"]


def lookup_contact(number):
    want = digits(number)[-9:]
    if len(want) < 6:
        return ""
    for label, phone in contact_rows():
        if label and digits(phone)[-9:] == want:
            return str(label)
    return ""


def call_text(path):
    """Phrase d'annonce d'un appel, ou "" s'il ne faut rien dire."""
    with CALLS_LOCK:
        c = CALLS.get(path)
        if not c:
            return ""
        if c.get("text") is not None:
            return c["text"]
        number, name = c["number"], c["name"]
    cc = CFG.get("calls", {})
    lang = CFG.get("language", "fr")
    if not name and number:
        name = lookup_contact(number)
        if not name:
            dbg("numéro absent du carnet ou carnet illisible :",
                _contacts.get("error") or "%d numéros lus" %
                len(_contacts["rows"] or []))
    text = ""
    if name:
        text = phrase("call", lang).format(name)
    elif number and number.lower() not in ("withheld", "unknown",
                                           "restricted"):
        if cc.get("announce_unknown", True):
            text = phrase("call_number", lang).format(
                speakable_number(number, lang))
    elif cc.get("announce_unknown", True):
        text = phrase("call_hidden", lang)
    with CALLS_LOCK:
        if path in CALLS:
            CALLS[path]["name"] = name
            CALLS[path]["text"] = text
    return text


def prepare_call(path):
    """Dès l'arrivée de l'appel : cherche le nom et fabrique le son, pendant
    que le système éteint puis que l'on rallume le casque."""
    try:
        text = call_text(path)
        if text and CFG.get("calls", {}).get("enabled", True):
            SPEAKER.render(text, CFG.get("language", "fr"), cache=True)
            dbg("annonce prête : %s" % text)
    except Exception as exc:
        log("préparation de l'annonce impossible :", exc)


def announce_call(path):
    with CALLS_LOCK:
        c = CALLS.get(path)
        if not c or c["state"] not in ("incoming", "waiting"):
            return
        c["announced"] += 1
    cc = CFG.get("calls", {})
    if not cc.get("enabled", True):
        return
    lang = CFG.get("language", "fr")
    text = call_text(path)
    if not text:
        return
    forget_route()
    # Casque Bluetooth éteint par la sonnerie : on le rallume, mais jamais
    # pendant une conversation déjà en cours (double appel).
    if cc.get("bt_wakeup", True) and not in_call():
        # En début de sonnerie, le système n'a peut-être pas encore éteint
        # le casque : une annonce lancée trop tôt serait coupée en route et
        # finirait sur le haut-parleur. On attend donc cette coupure.
        with CALLS_LOCK:
            age = time.time() - CALLS.get(path, {}).get("since", 0)
        if age < 6 and any(n.startswith("bluez_card") and a == "a2dp_sink"
                           for n, a, _p in pactl_cards()):
            for _ in range(30):
                time.sleep(0.1)
                if not any(n.startswith("bluez_card") and a == "a2dp_sink"
                           for n, a, _p in pactl_cards()):
                    break
            forget_route()
    if cc.get("bt_wakeup", True) and not in_call() and \
            audio_output() == "speaker":
        if wake_bt_headset():
            dbg("casque Bluetooth rallumé pour l'annonce")
    reason = blocked_reason(call=True)
    if reason:
        dbg("appel non annoncé (%s)" % reason)
        return
    SPEAKER.say(text, lang=lang, prio=1, props_key="call_props", tag=path)


def on_ofono_message(head, vals):
    member = head.get("member")
    path = head.get("path", "")
    if member == "CallAdded" and len(vals) >= 2:
        cpath, props = vals[0], vals[1] if isinstance(vals[1], dict) else {}
        state = str(props.get("State", ""))
        with CALLS_LOCK:
            CALLS[cpath] = {"state": state,
                            "number": str(props.get("LineIdentification", "")),
                            "name": "", "announced": 0, "text": None,
                            "since": time.time()}
        dbg("appel ajouté", cpath, state)
        if state in ("incoming", "waiting"):
            threading.Thread(target=prepare_call, args=(cpath,),
                             daemon=True).start()
    elif member == "CallRemoved" and vals:
        LAST_CALL_END[0] = time.time()
        with CALLS_LOCK:
            CALLS.pop(vals[0], None)
        SPEAKER.cancel(vals[0])
        dbg("appel retiré", vals[0])
    elif member == "PropertyChanged" and len(vals) >= 2 and \
            head.get("interface") == "org.ofono.VoiceCall":
        if vals[0] == "State":
            with CALLS_LOCK:
                if path in CALLS:
                    CALLS[path]["state"] = str(vals[1])
            if str(vals[1]) not in ("incoming", "waiting"):
                SPEAKER.cancel(path)
            dbg("état de l'appel", path, vals[1])
        elif vals[0] == "LineIdentification":
            with CALLS_LOCK:
                if path in CALLS:
                    CALLS[path]["number"] = str(vals[1])
                    CALLS[path]["text"] = None



