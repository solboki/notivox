class Speaker(threading.Thread):
    """Lit les annonces une par une. Une annonce d'appel interrompt la
    lecture en cours et passe devant les notifications en attente."""

    def __init__(self, pool):
        super().__init__(daemon=True)
        self.pool = pool
        self.q = queue.PriorityQueue()
        self.seq = 0
        self.lock = threading.Lock()
        self.current = None      # (priorité, Popen du lecteur)
        self.last_spoken = ""
        self.last_error = ""

    def say(self, text, lang=None, prio=5, props_key="notification_props",
            tag=None, force=False, voice=None, done=None):
        """done : fonction appelée si l'annonce a été jouée jusqu'au bout.
        force : True pour parler quoi qu'il arrive, "speaker" pour accepter
        le haut-parleur faute d'écouteurs. text peut être un tuple
        ("wav", chemin) pour jouer un son déjà prêt (bip, silence, phrase
        préparée à l'avance)."""
        with self.lock:
            self.seq += 1
            # Au-delà de cinq notifications en attente, on oublie les plus
            # anciennes : mieux vaut perdre un message que parler en retard.
            if prio >= 5 and self.q.qsize() >= 5:
                kept = []
                while not self.q.empty():
                    kept.append(self.q.get_nowait())
                kept.sort()
                calls = [k for k in kept if k[0] < 5]
                notifs = [k for k in kept if k[0] >= 5][-4:]
                for k in calls + notifs:
                    self.q.put(k)
            self.q.put((prio, self.seq, text, lang, props_key, tag, force,
                        voice, done))
            cur = self.current
        if cur and prio < cur[0]:
            self.interrupt()

    def cancel(self, tag):
        """Retire de la file les annonces portant cette étiquette."""
        kept = []
        while not self.q.empty():
            item = self.q.get_nowait()
            if item[5] != tag:
                kept.append(item)
        for k in kept:
            self.q.put(k)
        cur = self.current
        if cur and cur[2] == tag:
            self.interrupt()

    def interrupt(self):
        cur = self.current
        if cur and cur[1]:
            try:
                cur[1].terminate()
            except Exception:
                pass

    def run(self):
        os.makedirs(CACHE_DIR, exist_ok=True)
        while True:
            prio, _seq, text, lang, props_key, tag, force, voice, done = \
                self.q.get()
            try:
                if self.speak(prio, text, lang, props_key, tag, force,
                              voice) and done:
                    done()
            except Exception as exc:
                self.last_error = str(exc)
                log("échec de la lecture :", exc)

    def render(self, text, lang, want=None, cache=False, path=None):
        """Fabrique le fichier WAV d'un texte et renvoie (chemin, voix).

        Avec cache, le fichier est gardé : les annonces d'appel sont ainsi
        prêtes avant même que le casque soit disponible, et instantanées
        quand la même personne rappelle."""
        lang = lang or CFG.get("language", "fr")
        speed = float(CFG.get("speed", 1.0) or 1.0)
        voice = want if want in installed_voices() else choose_voice(lang)
        if not voice and lang != CFG.get("language"):
            if not CFG.get("espeak_fallback"):
                lang = CFG.get("language", "fr")
                voice = choose_voice(lang)
        volume = int(CFG.get("volume", 100))
        if cache:
            import hashlib
            key = hashlib.md5(("%s|%s|%s|%s|%s" % (
                voice or "espeak-" + lang, speed, volume, VERSION, text)
            ).encode("utf-8")).hexdigest()
            d = os.path.join(CACHE_DIR, "calls")
            os.makedirs(d, exist_ok=True)
            out = os.path.join(d, key + ".wav")
            if os.path.exists(out):
                return out, voice
            tmp = out + ".tmp.wav"
        elif path:
            tmp = out = path
        else:
            with self.lock:
                self.seq += 1
                n = self.seq
            tmp = out = os.path.join(CACHE_DIR, "say-%d-%d.wav" % (
                os.getpid(), n % 4))
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        if voice:
            self.pool.synth(voice, text, tmp, speed)
        elif CFG.get("espeak_fallback", True):
            espeak_synth(lang, text, tmp, speed)
        else:
            raise RuntimeError("aucune voix installée pour « %s »" % lang)
        apply_volume(tmp, volume)
        if tmp != out:
            os.replace(tmp, out)
        return out, voice

    def speak(self, prio, text, lang, props_key, tag, force, want=None):
        """Joue une annonce. Renvoie True si elle a été entendue en entier."""
        is_call = props_key == "call_props"
        if is_call:
            forget_route()
        label = text[1] if isinstance(text, tuple) else text
        if force is not True and not may_speak(
                call=is_call, speaker_ok=force == "speaker"):
            dbg("lecture annulée au dernier moment :", label[:60])
            return False
        lang = lang or CFG.get("language", "fr")
        if isinstance(text, tuple):
            out, voice = text[1], (text[2] if len(text) > 2 else "son")
            text = text[3] if len(text) > 3 else os.path.basename(out)
        else:
            out, voice = self.render(text, lang, want, cache=is_call)
        props = parse_props(CFG.get("audio", {}).get(props_key, ""))
        props.append(("media.title", "Notivox"))
        kind, device = audio_route()
        cmd = player_command(out, props, device)
        if not cmd:
            raise RuntimeError("aucun lecteur audio (paplay, gst-launch-1.0)")
        dbg("lecture [%s/%s] vers %s : %s" % (lang, voice or "espeak",
                                              device or "défaut", text[:80]))
        if tag and tag in CALLS:
            dbg("annonce lancée %.1f s après le début de la sonnerie" %
                (time.time() - CALLS[tag]["since"]))
        p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                             stderr=subprocess.PIPE, text=True)
        self.current = (prio, p, tag)
        try:
            _, err = p.communicate(timeout=120)
            if p.returncode not in (0, -15) and err:
                self.last_error = err.strip()[:200]
                log("le lecteur audio a signalé :", err.strip()[:200])
        except subprocess.TimeoutExpired:
            p.kill()
        finally:
            self.current = None
        self.last_spoken = text[:120]
        if p.returncode == 0:
            self.last_error = ""
            return True
        return False


