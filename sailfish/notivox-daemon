def detect_language(text, candidates, default):
    """Devine la langue d'un texte parmi les langues candidates (celles
    pour lesquelles une voix est installée). Renvoie default en cas de
    doute, en particulier pour les textes très courts."""
    if not text:
        return default
    if re.search(r"[Ѐ-ӿ]", text):
        if re.search(r"[іїєґІЇЄҐ]", text) and "uk" in candidates:
            return "uk"
        for c in ("ru", "uk", "bg", "sr", "kk"):
            if c in candidates:
                return c
    scripts = [("el", r"[Ͱ-Ͽ]"), ("ar", r"[؀-ۿ]"),
               ("fa", r"[؀-ۿ]"), ("he", r"[֐-׿]"),
               ("ka", r"[Ⴀ-ჿ]"), ("hy", r"[԰-֏]"),
               ("zh", r"[一-鿿]"), ("hi", r"[ऀ-ॿ]"),
               ("th", r"[฀-๿]")]
    for code, rx in scripts:
        if re.search(rx, text) and code in candidates:
            return code
    words = re.findall(r"[^\W\d_]+", text.lower())
    if len(words) < 3:
        return default
    scores = {}
    for lang in candidates:
        sw = STOPWORDS.get(lang)
        if sw:
            scores[lang] = sum(1 for w in words if w in sw)
    if not scores:
        return default
    best = max(scores, key=lambda k: (scores[k], k == default))
    # Il faut au moins deux mots outils reconnus, et plus que pour la
    # langue par défaut : un seul « moi » ne fait pas un texte finnois.
    # Il faut aussi une nette avance sur la langue par défaut : deux
    # langues voisines partagent beaucoup de petits mots (« la », « se »).
    if scores[best] < 2 or scores[best] - scores.get(default, 0) < 2:
        return default
    return best


def candidate_langs():
    """Langues entre lesquelles choisir : celles des voix installées, plus
    toutes celles que l'on sait reconnaître si eSpeak NG peut servir de
    voix de secours."""
    cands = set(voice_lang(v) for v in installed_voices())
    cands.add(CFG.get("language", "fr"))
    if CFG.get("espeak_fallback", True):
        cands |= set(STOPWORDS) | {"ru", "uk", "el", "ar", "he"}
    return cands


def phrase(key, lang):
    return PHRASES.get(lang, PHRASES["en"]).get(key) or PHRASES["en"][key]


def speakable_number(number, lang):
    d = re.sub(r"[^\d+]", "", number or "")
    if lang == "fr" and d.startswith("+33") and len(d) == 12:
        d = "0" + d[3:]
    if lang == "fr" and len(d) == 10 and d.startswith("0"):
        return " ".join(d[i:i + 2] for i in range(0, 10, 2))
    return " ".join(d) if len(d) <= 6 else \
        " ".join(d[i:i + 3] for i in range(0, len(d), 3))


