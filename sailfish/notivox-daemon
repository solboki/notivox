def notification_type(app, category):
    """Famille d'une notification, d'après sa catégorie (et à défaut le nom
    de l'application qui l'a publiée)."""
    c = (category or "").lower()
    a = (app or "").lower()
    if c.startswith("x-nemo.call") or "call.missed" in c:
        return "calls"
    if c.startswith(("x-nemo.messaging", "im.")) or c in ("im", "msg"):
        return "messages"
    if c.startswith(("x-nemo.email", "email")):
        return "email"
    if c.startswith(("x-nemo.calendar", "x-nemo.alarm", "x-nemo.reminder",
                     "x-nemo.organizer")) or c in ("event", "reminder",
                                                  "alarm"):
        return "calendar"
    if c.startswith(("x-nemo.system", "x-nemo.battery", "x-nemo.transfer",
                     "x-nemo.software-update", "x-nemo.connectivity",
                     "x-nemo.general", "x-nemo.ssu", "x-nemo.usb",
                     "x-nemo.storage", "device", "network", "transfer",
                     "presence")):
        return "system"
    if a in ("messages", "commhistoryd"):
        return "messages"
    if a in ("téléphone", "phone", "voicecall-ui"):
        return "calls"
    return "other"


def events_db_path():
