    if os.path.exists(os.path.join(CONF_DIR, "service-disabled")) and \
            "--force" not in sys.argv:
        log("service désactivé dans les réglages : arrêt")
        return
    log("démarrage, version", VERSION)
    for d in (CONF_DIR, VOICE_DIR, CACHE_DIR):
        os.makedirs(d, exist_ok=True)
    cfg_w = Watched(CONFIG_FILE, DEFAULT_CONFIG)
    st_w = Watched(STATE_FILE, DEFAULT_STATE)
    CFG = cfg_w.load()
    if os.path.exists(CONFIG_FILE) and migrate(CFG):
        write_json(CONFIG_FILE, CFG)
        log("réglages mis à jour pour cette version")
    cfg_w.changed()
    STATE = st_w.load()
    st_w.changed()
    if not os.path.exists(CONFIG_FILE):
        write_json(CONFIG_FILE, CFG)
        cfg_w.changed()
    SEEN = read_json(SEEN_FILE, {})
    for name in os.listdir(CACHE_DIR):
        if name.startswith("say-") and name.endswith(".wav"):
            try:
                os.unlink(os.path.join(CACHE_DIR, name))
            except OSError:
                pass

    pool = PiperPool()
    SPEAKER = Speaker(pool)
    SPEAKER.start()

    def stop(*_):
        pool.stop()
        if SEEN_DIRTY[0]:
            write_json(SEEN_FILE, SEEN)
        os._exit(0)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    threading.Thread(target=monitor, daemon=True, args=(
        "session",
        ["type='method_call',interface='org.freedesktop.Notifications',"
         "member='Notify'",
         "type='signal',interface='%s'" % CONTROL_IFACE],
        on_session_message, "notifications")).start()
    threading.Thread(target=monitor, daemon=True, args=(
        OFONO_BUS,
        ["type='signal',interface='org.ofono.VoiceCallManager'",
         "type='signal',interface='org.ofono.VoiceCall'"],
        on_ofono_message, "appels")).start()

    threading.Thread(target=headset_watch, daemon=True).start()

    last_status = last_seen = last_clean = 0
    while True:
        time.sleep(0.5)
        now = time.time()
        if cfg_w.changed():
            CFG = cfg_w.load()
            dbg("réglages relus")
        if st_w.changed():
            STATE = st_w.load()
            dbg("état relu :", STATE)
        with CALLS_LOCK:
            for c in CALLS.values():
                c.pop("pending", None)
        cc = CFG.get("calls", {})
        first = float(cc.get("first_delay", 1.5))
        interval = max(2.0, float(cc.get("interval", 6)))
        repeat = max(1, int(cc.get("repeat", 3)))
        with CALLS_LOCK:
            due = [p for p, c in CALLS.items()
                   if c["state"] in ("incoming", "waiting")
                   and c.get("sched", 0) < repeat
                   and now >= c["since"] + first + c.get("sched", 0) *
                   interval]
            for p in due:
                CALLS[p]["sched"] = CALLS[p].get("sched", 0) + 1
        for p in due:
            threading.Thread(target=announce_call, args=(p,),
                             daemon=True).start()
        if now - last_status > 5:
            write_status(pool)
            last_status = now
        if SEEN_DIRTY[0] and now - last_seen > 10:
            SEEN_DIRTY[0] = False
            try:
                write_json(SEEN_FILE, SEEN)
            except Exception as exc:
                log("liste des applications non écrite :", exc)
            last_seen = now
        if now - last_clean > 30:
            # La voix de la langue principale reste chargée : une annonce
            # d'appel n'attend pas le chargement du modèle.
            pool.cleanup(keep=choose_voice(CFG.get("language", "fr")))
            last_clean = now


